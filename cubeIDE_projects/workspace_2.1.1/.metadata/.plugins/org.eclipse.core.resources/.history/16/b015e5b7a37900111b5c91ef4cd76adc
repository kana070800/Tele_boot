#ifndef __UART_TASK_H__
#define __UART_TASK_H__

#include "main.h"
#include "FreeRTOS.h"
#include "task.h"
#include "semphr.h"
#include "queue.h"

/* --- [1. 시스템 상태 및 모듈 타입 열거형 (RPi와 일치)] --- */
typedef enum {
    SYS_IDLE = 0, SYS_IDENTIFY, SYS_AUTHENTICATE,
    SYS_NEGOTIATE, SYS_ACTIVE, SYS_FAULT, SYS_QUARANTINE
} SystemState_t;

typedef enum {
    FAULT_NONE = 0, FAULT_IDENTIFY_TIMEOUT, FAULT_AUTH_FAIL,
    FAULT_AUTH_TIMEOUT, FAULT_POWER_REJECT, FAULT_NEGOTIATE_TIMEOUT,
    FAULT_POWER_VIOLATION_MAX
} FaultCode_t;

typedef enum {
    MODULE_NONE = 0, MODULE_GENERAL, MODULE_COLD_CHAIN, MODULE_UNKNOWN
} ModuleType_t;

/* --- [2. 공유 데이터 구조체 (pthread_mutex 제외됨)] --- */
typedef struct {
    SystemState_t system_state;
    ModuleType_t module_type;
    FaultCode_t latest_fault;
    uint32_t module_id;
    uint8_t dock_detected;
    uint8_t auth_result;
    uint8_t power_granted;
    uint8_t module_function_enabled;
    float target_speed_rpm;
    float current_speed_rpm;
    uint16_t motor_pwm_duty;
    float requested_power_w;
    float granted_power_w;
    float reported_power_w;
    uint8_t power_violation_count;
    float pressure_value;
    float target_temp_c;
    float current_temp_c;
    uint8_t peltier_pwm;
    uint8_t fan_pwm;
    uint8_t warning_flag;
    uint8_t sleep_flag;
} SystemSharedData_t;

/* --- [3. 통신 패킷 정의 (1바이트 정렬)] --- */
#pragma pack(push, 1)
typedef struct {
    uint32_t module_type;
    uint32_t module_id;
    float    granted_power_w;
    float    target_temp_c;
    uint8_t  warning_flag;
    float    target_speed_rpm;
} RtS_Packet_t; // Raspberry Pi to STM32 (수신)

typedef struct {
    uint32_t module_type;
    uint32_t module_id;
    float    reported_power_w;
    float    current_pressure;
    float    current_temp_c;
    uint8_t  warning_flag;
    float    current_speed_rpm;
} StR_Packet_t; // STM32 to Raspberry Pi (송신)
#pragma pack(pop)

/* --- [4. 외부 참조 변수 및 함수 프로토타입] --- */
extern UART_HandleTypeDef huart3;          // main.c 또는 usart.c에 선언된 UART 핸들
extern SystemSharedData_t g_shm_data;      // 시스템 전역 공유 데이터
extern SemaphoreHandle_t  g_shm_mutex;     // 공유 데이터 보호용 FreeRTOS Mutex
extern QueueHandle_t      g_uart_rx_queue; // RX 인터럽트 -> Task 데이터 전달용 큐

void UART_Task_Init(void);
void StartUARTTask(void *argument);

#endif /* __UART_TASK_H__ */
