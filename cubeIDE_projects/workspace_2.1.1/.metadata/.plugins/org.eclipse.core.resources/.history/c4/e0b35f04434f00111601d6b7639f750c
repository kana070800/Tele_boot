void IWDG_Init_1s(void)
{
    /*
     * IWDG clock source인 LSI enable
     *
     * IWDG는 APB/AHB 같은 메인 시스템 클럭이 아니라
     * LSI 저속 내부 RC clock을 사용한다.
     */
    RCC->CSR |= RCC_CSR_LSION;

    /*
     * LSI가 안정화될 때까지 대기
     */
    while ((RCC->CSR & RCC_CSR_LSIRDY) == 0)
    {
    }
    IWDG->KR = 0xCCCC;
    /*
     * PR, RLR write access enable
     *
     * IWDG_PR, IWDG_RLR 레지스터는 보호되어 있기 때문에
     * KR에 0x5555를 먼저 써야 수정 가능하다.
     */
    IWDG->KR = 0x5555;

    /*
     * Prescaler 설정
     *
     * PR = 0x6 -> LSI clock / 256
     */
    IWDG->PR = 0x6;

    /*
     * Reload 설정
     *
     * RLR = 0xF9 = 249
     *
     * timeout 계산:
     * timeout ≈ (RLR + 1) * Prescaler / LSI
     *
     * LSI를 약 32kHz로 보면:
     * timeout ≈ (249 + 1) * 256 / 32000
     *         ≈ 2초
     *
     * 즉 약 1초 안에 IWDG_Refresh()가 호출되지 않으면 reset 발생.
     */
    IWDG->RLR = 0xF9;

    /*
     * 설정 반영 완료 대기
     *
     * IWDG->SR의 PVU, RVU bit가 0이 될 때까지 기다린다.
     * prescaler/reload 값이 실제로 반영되는 중이면 SR이 0이 아니다.
     */
    while (IWDG->SR != 0)
    {
    }

    /*
     * Counter reload
     *
     * KR에 0xAAAA를 쓰면 RLR 값이 counter에 다시 로드된다.
     */
    IWDG->KR = 0xAAAA;

    /*
     * IWDG start
     *
     * KR에 0xCCCC를 쓰면 IWDG가 시작된다.
     * 한 번 시작하면 reset 전까지 소프트웨어로 끌 수 없다.
     */
//    IWDG->KR = 0xCCCC;
}


void IWDG_Refresh(void)
{
    /*
     * Watchdog refresh/feed
     *
     * timeout이 지나기 전에 이 코드를 계속 실행하면 reset이 발생하지 않는다.
     * 반대로 프로그램이 멈추거나 이 코드가 실행되지 않으면 IWDG reset 발생.
     */
    IWDG->KR = 0xAAAA;
}


