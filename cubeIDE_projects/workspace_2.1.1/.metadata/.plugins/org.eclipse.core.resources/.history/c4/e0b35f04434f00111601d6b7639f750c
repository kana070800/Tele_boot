/* --- 설정 및 상수 --- */
#define SLAVE_ADDR     0x27
#define RS_BIT         0x01
#define EN_BIT         0x04
#define BACKLIGHT      0x08

/* --- I2C 상태 정의 --- */
typedef enum {
    I2C_IDLE,
    I2C_START,
    I2C_ADDR,
    I2C_WRITE_BYTE,
    I2C_STOP
} I2C_Step_t;

/* --- 전역 변수 --- */
I2C_Step_t i2c_step = I2C_IDLE;
uint8_t tx_buffer[256];      // 전송할 바이트들을 담는 큐
uint16_t tx_index = 0;       // 현재 전송 중인 위치
uint16_t tx_len = 0;         // 전체 전송할 길이

