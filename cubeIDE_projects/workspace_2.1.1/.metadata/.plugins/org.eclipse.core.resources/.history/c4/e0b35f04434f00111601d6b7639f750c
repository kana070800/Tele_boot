/* --- I2C 상태 머신 (핵심 로직) --- */
void Process_I2C_Machine(void) {
    if (tx_index >= tx_len) {
        tx_index = tx_len = 0; // 전송 완료 시 초기화
        i2c_step = I2C_IDLE;
        return;
    }

    switch (i2c_step) {
        case I2C_IDLE:
            if (tx_len > 0) i2c_step = I2C_START;
            break;

        case I2C_START:
            I2C1->CR1 |= I2C_CR1_START; // Start 신호 발생 [cite: 379]
            i2c_step = I2C_ADDR;
            break;

        case I2C_ADDR:
            if (I2C1->SR1 & I2C_SR1_SB) { // Start 완료 확인 [cite: 379]
                I2C1->DR = (SLAVE_ADDR << 1); // 주소 전송 [cite: 369]
                i2c_step = I2C_WRITE_BYTE;
            }
            break;

        case I2C_WRITE_BYTE:
            if (I2C1->SR1 & I2C_SR1_ADDR) { // 주소 응답 확인 [cite: 376]
                (void)I2C1->SR2;
            }
            if (I2C1->SR1 & I2C_SR1_TXE) { // 송신 버퍼 비었는지 확인 [cite: 381]
                I2C1->DR = tx_buffer[tx_index++]; // 데이터 하나 전송 [cite: 362]
                if (tx_index >= tx_len) i2c_step = I2C_STOP;
                // 다음 바이트가 있다면 계속 WRITE_BYTE 상태 유지
            }
            break;

        case I2C_STOP:
            if (I2C1->SR1 & I2C_SR1_BTF) { // 바이트 전송 최종 완료 확인
                I2C1->CR1 |= I2C_CR1_STOP; // Stop 신호 발생 [cite: 418]
                i2c_step = I2C_IDLE;
            }
            break;
    }
}

/* --- LCD 데이터를 큐에 추가하는 함수 --- */
void LCD_Enqueue(uint8_t data, uint8_t flags) {
    if (tx_len + 4 >= 256) return; // 버퍼 가득 참 방지

    uint8_t up = (data & 0xF0) | flags | BACKLIGHT;
    uint8_t lo = ((data << 4) & 0xF0) | flags | BACKLIGHT;

    // 4비트 전송을 위한 4단계 패킷 구성
    tx_buffer[tx_len++] = up | EN_BIT;
    tx_buffer[tx_len++] = up & ~EN_BIT;
    tx_buffer[tx_len++] = lo | EN_BIT;
    tx_buffer[tx_len++] = lo & ~EN_BIT;
}

void LCD_Print(char *str) {
    while (*str) {
        LCD_Enqueue((uint8_t)(*str++), RS_BIT);
    }
}

/* --- 초기화 시퀀스 --- */
void LCD_Init_Sequence(void) {
    // 초기화 시퀀스 명령들을 버퍼에 미리 넣음
    LCD_Enqueue(0x33, 0);
    LCD_Enqueue(0x32, 0);
    LCD_Enqueue(0x28, 0); // 2라인 모드
    LCD_Enqueue(0x0C, 0); // Display ON
    LCD_Enqueue(0x01, 0); // Clear Display
}

/* --- 하드웨어 설정 --- */
void I2C1_Config(void) {
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;

    GPIOB->MODER &= ~((3 << (8 * 2)) | (3 << (9 * 2)));
    GPIOB->MODER |=  ((2 << (8 * 2)) | (2 << (9 * 2)));
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);
    GPIOB->AFR[1] |= (4 << (0 * 4)) | (4 << (1 * 4));

    I2C1->CR2 = 45;
    I2C1->CCR = 225;
    I2C1->TRISE = 46;
    I2C1->CR1 |= I2C_CR1_PE;
}
