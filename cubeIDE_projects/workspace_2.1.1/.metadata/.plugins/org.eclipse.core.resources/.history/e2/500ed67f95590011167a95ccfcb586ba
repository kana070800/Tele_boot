void Buzzer_Play_Elise(void)
{
    /*
     * 엘리제를 위하여 오른손 단선율 버전
     * 시작 계이름:
     * 미 레# 미 레# 미 시 레 도 라 ...
     */

    unsigned int melody[] = {
        NOTE_E5, NOTE_DS5, NOTE_E5, NOTE_DS5, NOTE_E5,
        NOTE_B4, NOTE_D5,  NOTE_C5,  NOTE_A4,

        NOTE_REST,

