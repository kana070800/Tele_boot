void TIMER6_init(void)
{
	// [1] RCC 활성화 : TIM6EN, GPIOD, (LED : PB0, PB7, PB14)
	RCC->APB1ENR |= (0x1<<4);				//	TIM6 EN
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN; 	//	GPIO B EN

	// [2] TIM6 설정 (input) : 주기 50ms, 인터럽트 enable, UG로 강제 업데이트
	//CK_PSC = 84Mhz
	//CK_CNT = 84Mhz / (839 + 1) = 100khz
	TIM6->PSC = 840 - 1;
	TIM6->ARR = 10000 -1;					//주기 100ms

	TIM6->DIER |= (1<<0);					//	인터럽트 활성화
	TIM6->EGR |= (1<<0);					//	강제 업데이트

	// [3] GPIO B 설정 (output) MODER=01,
	GPIOB->MODER &= ~(0x3<<0);
	GPIOB->MODER |= (0x1<<0);

	// [4] TIM6 활성화
	TIM6->CR1 |= (1<<0);					//	TIM6 활성화

	// [5] NVIC 활성화
	NVIC_EnableIRQ(TIM6_DAC_IRQn);			//	TIM6_DAC_IRQn = 54

}

void I2C2_PB10_11_init(void)
{
	// [1] RCC 활성화 :I2C2 , GPIO B EN
	RCC->APB1ENR |= RCC_APB1ENR_I2C2EN;		//	I2C2 EN
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN; 	//	GPIO B EN

	// [2] GPIO B 설정 (output) MODER=1010, OTYPER
	GPIOB->MODER = (GPIOB->MODER & ~(0xF<<20)) | (0xA<<20);
	GPIOB->OTYPER |= (0x3<<10);
	GPIOB->OSPEEDR  = (GPIOB->OSPEEDR  & ~(0xF<<20)) | (0xA<<20);
	GPIOB->PUPDR  = (GPIOB->PUPDR  & ~(0xF<<20)) | (0x5<<20);

	GPIOB->AFR[1] &= ~(0xFF<<8);
	GPIOB->AFR[1] |= (0x44<<8);

	// [3] I2C
	 RCC->APB1RSTR |=  RCC_APB1RSTR_I2C2RST;
	 RCC->APB1RSTR &= ~RCC_APB1RSTR_I2C2RST;

	// 8. 설정 전 I2C Disable
	I2C2->CR1 &= ~I2C_CR1_PE;

	// 9. APB1 클럭 주파수 설정
	// APB1 = 42MHz
	I2C2->CR2 &= ~I2C_CR2_FREQ;
	I2C2->CR2 |= 42;

	// 10. Standard mode 100kHz
	// CCR = 42MHz / (2 * 100kHz) = 210
	I2C2->CCR = 210;

	// 11. TRISE = 42 + 1
	I2C2->TRISE = 43;

	// 12. ACK Enable
	I2C2->CR1 |= I2C_CR1_ACK;

	// 13. I2C2 Enable
	I2C2->CR1 |= I2C_CR1_PE;

}


static int I2C2_Wait_Flag_Set(volatile uint32_t *reg, uint32_t flag)
{
    uint32_t timeout = I2C_TIMEOUT;

    while (((*reg) & flag) == 0)
    {
        if (--timeout == 0)
            return -1;
    }

    return 0;
}

static int I2C2_Wait_Flag_Clear(volatile uint32_t *reg, uint32_t flag)
{
    uint32_t timeout = I2C_TIMEOUT;

    while (((*reg) & flag) != 0)
    {
        if (--timeout == 0)
            return -1;
    }

    return 0;
}

static void I2C2_Clear_ADDR(void)
{
    volatile uint32_t temp;

    temp = I2C2->SR1;
    temp = I2C2->SR2;
    (void)temp;
}


int I2C2_Write_Reg(uint8_t dev_addr, uint8_t reg_addr, uint8_t data)
{
    // BUSY가 풀릴 때까지 대기
    if (I2C2_Wait_Flag_Clear(&I2C2->SR2, I2C_SR2_BUSY) < 0)
        return -1;

    // START
    I2C2->CR1 |= I2C_CR1_START;
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_SB) < 0)
        return -2;

    // Slave address + Write
    I2C2->DR = dev_addr & ~0x01;
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_ADDR) < 0)
        return -3;
    I2C2_Clear_ADDR();

    // Register address 전송
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_TXE) < 0)
        return -4;
    I2C2->DR = reg_addr;

    // Data 전송
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_TXE) < 0)
        return -5;
    I2C2->DR = data;

    // 전송 완료 대기
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_BTF) < 0)
        return -6;

    // STOP
    I2C2->CR1 |= I2C_CR1_STOP;

    return 0;
}

int I2C2_Read_Reg(uint8_t dev_addr, uint8_t reg_addr, uint8_t *data)
{
    // BUSY가 풀릴 때까지 대기
    if (I2C2_Wait_Flag_Clear(&I2C2->SR2, I2C_SR2_BUSY) < 0)
        return -1;

    // START
    I2C2->CR1 |= I2C_CR1_START;
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_SB) < 0)
        return -2;

    // Slave address + Write
    I2C2->DR = dev_addr & ~0x01;
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_ADDR) < 0)
        return -3;
    I2C2_Clear_ADDR();

    // 읽고 싶은 register address 전송
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_TXE) < 0)
        return -4;
    I2C2->DR = reg_addr;

    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_BTF) < 0)
        return -5;

    // Repeated START
    I2C2->CR1 |= I2C_CR1_START;
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_SB) < 0)
        return -6;

    // Slave address + Read
    I2C2->DR = dev_addr | 0x01;
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_ADDR) < 0)
        return -7;

    // 1바이트 읽기이므로 ACK 끄기
    I2C2->CR1 &= ~I2C_CR1_ACK;

    // ADDR clear
    I2C2_Clear_ADDR();

    // STOP
    I2C2->CR1 |= I2C_CR1_STOP;

    // 데이터 수신 대기
    if (I2C2_Wait_Flag_Set(&I2C2->SR1, I2C_SR1_RXNE) < 0)
        return -8;

    *data = I2C2->DR;

    // 다음 통신을 위해 ACK 다시 켜기
    I2C2->CR1 |= I2C_CR1_ACK;

    return 0;
}

int ADXL345_Init(void)
{
    uint8_t id;
    int ret;

    ret = I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DEVID, &id);
    if (ret < 0)
    {
        Uart3_Printf("ADXL345 DEVID read fail: %d\r\n", ret);
        return -1;
    }

    Uart3_Printf("ADXL345 DEVID = 0x%02X\r\n", id);

    if (id != 0xE5)
    {
        Uart3_Printf("ADXL345 ID wrong\r\n");
        return -2;
    }

    // DATA_FORMAT
    // 0x08 = FULL_RES = 1, range = +-2g
    ret = I2C2_Write_Reg(ADXL345_ADDR, ADXL345_DATA_FORMAT, 0x08);
    if (ret < 0)
    {
        Uart3_Printf("DATA_FORMAT write fail: %d\r\n", ret);
        return -3;
    }

    // POWER_CTL
    // 0x08 = Measure bit set
    ret = I2C2_Write_Reg(ADXL345_ADDR, ADXL345_POWER_CTL, 0x08);
    if (ret < 0)
    {
        Uart3_Printf("POWER_CTL write fail: %d\r\n", ret);
        return -4;
    }

    Uart3_Printf("ADXL345 init OK\r\n");

    return 0;
}

int ADXL345_Read_Raw(int16_t *x, int16_t *y, int16_t *z)
{
    uint8_t x0, x1;
    uint8_t y0, y1;
    uint8_t z0, z1;

    if (I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DATAX0, &x0) < 0) return -1;
    if (I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DATAX1, &x1) < 0) return -2;
    if (I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DATAY0, &y0) < 0) return -3;
    if (I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DATAY1, &y1) < 0) return -4;
    if (I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DATAZ0, &z0) < 0) return -5;
    if (I2C2_Read_Reg(ADXL345_ADDR, ADXL345_DATAZ1, &z1) < 0) return -6;

    *x = (int16_t)((x1 << 8) | x0);
    *y = (int16_t)((y1 << 8) | y0);
    *z = (int16_t)((z1 << 8) | z0);

    return 0;
}


void Motor_Control(float angle)
{
    // -30 ~ +30 : 정지
    if(angle >= -100 && angle <= 100)
    {
        __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 1500);
    }

    // +30 이상 : 한 방향 회전
    else if(angle > 100 && angle <= 200)
    {
        __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 1700);
    }

    // -30 이하 : 반대 방향 회전
    else if(angle < -100 && angle >= -200)
    {
        __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 1300);
    }
}


