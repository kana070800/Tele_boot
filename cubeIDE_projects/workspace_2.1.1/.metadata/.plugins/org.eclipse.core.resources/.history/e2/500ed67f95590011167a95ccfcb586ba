/**
 * @brief HC-SR04 GPIO 초기화
 * Trig: PA0 (Output)
 * Echo: PB0 (Input) - 수정됨
 */
void HCSR04_Init(void) {
    // GPIOA(Trig) 및 GPIOB(Echo) 클럭 활성화
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIOBEN;

    // PA0 - Output mode (Trig)
    GPIOA->MODER &= ~(3 << (0 * 2));    // Reset
    GPIOA->MODER |= (1 << (0 * 2));     // General Purpose Output

    // PB0 - Input mode (Echo) - 수정됨
    GPIOB->MODER &= ~(3 << (0 * 2));    // 00: Input mode
    // PB0 내부 Pull-down 설정 (Echo 핀의 안정적인 상태 유지)
    GPIOB->PUPDR &= ~(3 << (0 * 2));
    GPIOB->PUPDR |= (2 << (0 * 2));     // 10: Pull-down
}

/**
 * @brief 초음파 센서 거리 측정
 */
float HCSR04_Read(void) {
    uint32_t count = 0;
    uint32_t timeout = 0;

    // 1. Trig(PA0) 10us High 펄스
    GPIOA->BSRR = GPIO_BSRR_BS0;
    Delay_us(10);
    GPIOA->BSRR = GPIO_BSRR_BR0;

    // 2. Echo(PB0)가 High가 될 때까지 대기
    timeout = 30000;
    while (!(GPIOB->IDR & GPIO_IDR_ID0)){
        if (--timeout == 0) {
            return g_distance;   // 또는 999.0f;
        }
        Delay_us(1);
    }

    // 3. Echo(PB0)가 High인 동안 시간 측정
    count = 0;
    while (GPIOB->IDR & GPIO_IDR_ID0) {   // PB0 체크로 변경
        count++;
        Delay_us(1);
        if(count > 30000) break; // 약 5미터 이상 무시 (Timeout)
    }

    // 4. 거리 계산 (실제 환경에 따라 보정 필요)
    // 소리 속도 340m/s -> 1cm 이동에 약 29us 소요 (왕복 58us)
    return (float)count * 0.017f;

}


