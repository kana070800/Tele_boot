/* ===================== TIM9 Clock Calculation ===================== */

/*
 * TIM9는 APB2 timer.
 *
 * APB2 prescaler가 1이면 TIM9 clock = PCLK2
 * APB2 prescaler가 1보다 크면 TIM9 clock = PCLK2 * 2
 *
 * 현재 RCC->CFGR 값을 보고 TIM9 clock을 계산.
 */
static unsigned int Get_TIM9_TimerClock_Hz(void)
{
    unsigned int hclk = SystemCoreClock;
    unsigned int ppre2 = (RCC->CFGR >> 13) & 0x7;
    unsigned int pclk2;
    unsigned int tim_clk;

    if (ppre2 < 4)
    {
        pclk2 = hclk;
        tim_clk = pclk2;
    }
    else
    {
        unsigned int shift = ppre2 - 3;
        pclk2 = hclk >> shift;
        tim_clk = pclk2 * 2;
    }

    return tim_clk;
}

/* ===================== TIM9 PE5 PWM Init ===================== */

/*
 * PE5 = TIM9_CH1 PWM 직접 초기화
 */
static void TIM9_PWM_PE5_Init(void)
{
    unsigned int tim_clk;
    unsigned int psc;

    SystemCoreClockUpdate();
    tim_clk = Get_TIM9_TimerClock_Hz();

    /*
     * GPIOE clock enable
     */
    RCC->AHB1ENR |= (1 << 4);   // GPIOEEN
    (void)RCC->AHB1ENR;

    /*
     * PE5 Alternate Function mode
     * MODER5[1:0] = 10
     */
    GPIOE->MODER &= ~(3 << (5 * 2));
    GPIOE->MODER |=  (2 << (5 * 2));

    /*
     * PE5 AF3 = TIM9_CH1
     */
    GPIOE->AFR[0] &= ~(0xF << (5 * 4));
    GPIOE->AFR[0] |=  (0x3 << (5 * 4));

    /*
     * Push-pull, no pull, high speed
     */
    GPIOE->OTYPER &= ~(1 << 5);

    GPIOE->PUPDR &= ~(3 << (5 * 2));

    GPIOE->OSPEEDR &= ~(3 << (5 * 2));
    GPIOE->OSPEEDR |=  (2 << (5 * 2));

    /*
     * TIM9 clock enable
     * TIM9 = APB2ENR bit 16
     */
    RCC->APB2ENR |= (1 << 16);
    (void)RCC->APB2ENR;

    /*
     * Timer stop
     */
    TIM9->CR1 = 0;

    /*
     * Timer tick을 1MHz로 맞춤.
     * psc = TIM9_clock / 1MHz - 1
     */
    if (tim_clk >= 1000000)
    {
        psc = (tim_clk / 1000000) - 1;
    }
    else
    {
        psc = 0;
    }

    TIM9->PSC = psc;

    /*
     * 기본 1kHz
     * 1MHz / (999 + 1) = 1kHz
     */
    TIM9->ARR = 999;
    TIM9->CCR1 = 500;

    /*
     * PWM mode 1 on CH1
     * OC1M = 110
     * OC1PE = 1
     */
    TIM9->CCMR1 &= ~((7 << 4) | (1 << 3));
    TIM9->CCMR1 |=  (6 << 4) | (1 << 3);

    /*
     * CH1 output enable
     */
    TIM9->CCER |= (1 << 0);   // CC1E

    /*
     * Auto-reload preload enable
     */
    TIM9->CR1 |= (1 << 7);    // ARPE

    /*
     * Update event
     */
    TIM9->EGR = 1;            // UG

    Buzzer_Stop();
}

static void PE5_PWM_Mode(void)
{
    /*
     * PE5 = Alternate Function mode
     * AF3 = TIM9_CH1
     */
    GPIOE->MODER &= ~(3 << (5 * 2));
    GPIOE->MODER |=  (2 << (5 * 2));

    GPIOE->AFR[0] &= ~(0xF << (5 * 4));
    GPIOE->AFR[0] |=  (0x3 << (5 * 4));
}

static void PE5_GPIO_Low_Mode(void)
{
    /*
     * PE5를 일반 GPIO output으로 바꾸고 LOW 출력
     * 부저 OFF를 확실하게 만들기 위함
     */
    GPIOE->MODER &= ~(3 << (5 * 2));
    GPIOE->MODER |=  (1 << (5 * 2));   // output mode

    GPIOE->OTYPER &= ~(1 << 5);        // push-pull
    GPIOE->ODR &= ~(1 << 5);           // PE5 LOW
}


/* ===================== Buzzer Basic Functions ===================== */

void Buzzer_SetFreq(unsigned int freq)
{
    unsigned int timer_tick = 1000000;   // TIM9 PSC 이후 1MHz 기준
    unsigned int arr;

    if (freq == 0)
    {
        Buzzer_Stop();
        return;
    }

    arr = (timer_tick / freq) - 1;

    TIM9->ARR = arr;
    TIM9->CCR1 = (arr + 1) / 2;   // duty 50%

    TIM9->EGR = 1;                // update event
}

void Buzzer_Start(void)
{
    /*
     * PE5를 다시 TIM9_CH1 PWM 핀으로 전환
     */
    PE5_PWM_Mode();

    /*
     * CH1 output enable
     */
    TIM9->CCER |= (1 << 0);      // CC1E = 1

    /*
     * Counter enable
     */
    TIM9->CR1 |= (1 << 0);       // CEN = 1
}

void Buzzer_Stop(void)
{
    /*
     * Timer counter stop
     */
    TIM9->CR1 &= ~(1 << 0);      // CEN = 0

    /*
     * CH1 output disable
     */
    TIM9->CCER &= ~(1 << 0);     // CC1E = 0

    /*
     * Duty 0
     */
    TIM9->CCR1 = 0;

    /*
     * PE5를 GPIO LOW로 강제 전환
     */
    PE5_GPIO_Low_Mode();
}

