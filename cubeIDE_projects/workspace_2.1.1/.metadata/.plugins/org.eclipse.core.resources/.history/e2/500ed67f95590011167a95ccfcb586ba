void ParkingSensor_Update_ByLoop(unsigned int distance_cm)
{
    static unsigned int counter = 0;
    static unsigned int buzzer_on = 0;

    unsigned int interval_count;
    unsigned int on_count;

    counter++;

    /*
     * 1. 너무 멀면 아예 안 울림
     * Blue ON, Red OFF
     */
    if (distance_cm > PARKING_NO_SOUND_CM)
    {
        Buzzer_Stop();
        buzzer_on = 0;
        counter = 0;

        ParkingSensor_LED_NoWarning();

        return;
    }

    /*
     * 2. 매우 가까우면 연속음
     * 이때는 더 높은 주파수로 삐이이
     * Red 계속 ON, Blue OFF
     */
    if (distance_cm <= PARKING_CONTINUOUS_CM)
    {
        if (buzzer_on == 0) {
            Buzzer_SetFreq(PARKING_CONTINUOUS_FREQ);
            Buzzer_Start();
            buzzer_on = 1;
        }

        counter = 0;
        ParkingSensor_LED_BeepOn();

        return;
    }

    /*
     * 3. 경고 범위 안에서는 주파수는 동일.
     * 가까워질수록 삐삐 간격만 빨라짐.
     */
    if (distance_cm <= PARKING_FAST_CM)
    {
        interval_count = 8000;
        on_count       = 4000;
    }
    else if (distance_cm <= PARKING_MID_CM)
    {
        interval_count = 18000;
        on_count       = 5000;
    }
    else if (distance_cm <= PARKING_SLOW_CM)
    {
        interval_count = 35000;
        on_count       = 6000;
    }
    else
    {
        interval_count = 65000;
        on_count       = 7000;
    }

    /*
     * 4. 현재 부저 OFF 상태
     * interval 지나면 부저 ON + Red ON
     * 이 쉬는 구간에서는 BLue 켜지 않음.
     */
    if (buzzer_on == 0)
    {
        ParkingSensor_LED_BeepOff();

        if (counter >= interval_count)
        {
            Buzzer_SetFreq(PARKING_BEEP_FREQ);
            Buzzer_Start();

            ParkingSensor_LED_BeepOn();

            buzzer_on = 1;
            counter = 0;
        }
    }
    /*
     * 5. 현재 부저 ON 상태
     * on_count 지나면 부저 OFF + LED 둘 다 OFF
     */
    else
    {
        ParkingSensor_LED_BeepOn();

        if (counter >= on_count)
        {
            Buzzer_Stop();

            ParkingSensor_LED_BeepOff();

            buzzer_on = 0;
            counter = 0;
        }
    }
}


uint32_t Get_Time_us(void) {
    // TIM5 is a 32-bit timer, so it counts up to 4,294,967,295 us (approx 71.5 minutes) natively.
    // Unsigned 32-bit math handles the overflow automatically for differences.
    return TIM5->CNT;
}

/* --- I2C State Machine (Main Loop Logic) --- */
void Process_I2C_Machine(void) {
    if (i2c_step == I2C_IDLE) {

        // 1. Check if all queued data has been sent
        if (tx_len > 0 && tx_index >= tx_len) {

            // Disable IRQ ONLY right before clearing the queue
            __disable_irq();

            // Double-check to ensure EXTI didn't add data just before IRQ was disabled
            if (tx_index >= tx_len) {
                tx_index = 0;
                tx_len = 0;
            }

            __enable_irq();
            return;
        }

        // 2. Check if there is new data to send
        if (tx_len > 0 && tx_index < tx_len) {
            i2c_step = I2C_START;
            I2C1->CR2 |= (I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN);
            I2C1->CR1 |= I2C_CR1_START;
        }
    }
    else if (i2c_step == I2C_WAIT) {
        if ((Get_Time_us() - wait_start_time) >= current_wait_delay) {
            i2c_step = I2C_IDLE;
        }
    }
}


/* --- I2C Event Interrupt Handler --- */
void I2C1_EV_IRQHandler(void) {
    uint32_t sr1 = I2C1->SR1;

    if (sr1 & I2C_SR1_SB) {
        I2C1->DR = (SLAVE_ADDR << 1);
        i2c_step = I2C_WRITE_BYTE;
    }
    else if (sr1 & I2C_SR1_ADDR) {
        (void)I2C1->SR2;
    }
    else if (sr1 & I2C_SR1_BTF) {
        if (i2c_step == I2C_STOP || i2c_step == I2C_STOP_AND_WAIT) {
            I2C1->CR1 |= I2C_CR1_STOP;
            I2C1->CR2 &= ~(I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN);

            if (i2c_step == I2C_STOP_AND_WAIT) {
                wait_start_time = Get_Time_us();
                i2c_step = I2C_WAIT;
            } else {
                i2c_step = I2C_IDLE;
            }
        }
    }
    else if (sr1 & I2C_SR1_TXE) {
        if (i2c_step == I2C_WRITE_BYTE) {
            I2C1->DR = tx_buffer[tx_index];
            current_wait_delay = tx_delay[tx_index];
            tx_index++;

            if (tx_index >= tx_len) {
                i2c_step = I2C_STOP;
            } else if (current_wait_delay > 0) {
                i2c_step = I2C_STOP_AND_WAIT;
            }
        }
    }
}

/* --- LCD Data Enqueue Functions --- */
void LCD_Enqueue_4bit(uint8_t data, uint32_t delay_us) {
    if (tx_len + 2 >= QUEUE_SIZE) return;
    uint8_t val = (data & 0xF0) | BACKLIGHT;

    tx_buffer[tx_len] = val | EN_BIT;   tx_delay[tx_len++] = 1;
    tx_buffer[tx_len] = val & ~EN_BIT;  tx_delay[tx_len++] = delay_us;
}

void LCD_Enqueue(uint8_t data, uint8_t flags, uint32_t delay_us) {
    if (tx_len + 4 >= QUEUE_SIZE) return;

    uint8_t up = (data & 0xF0) | flags | BACKLIGHT;
    uint8_t lo = ((data << 4) & 0xF0) | flags | BACKLIGHT;

    tx_buffer[tx_len] = up | EN_BIT;   tx_delay[tx_len++] = 1;
    tx_buffer[tx_len] = up & ~EN_BIT;  tx_delay[tx_len++] = 40;

    tx_buffer[tx_len] = lo | EN_BIT;   tx_delay[tx_len++] = 1;
    tx_buffer[tx_len] = lo & ~EN_BIT;  tx_delay[tx_len++] = delay_us;
}

void LCD_Print(char *str) {
    while (*str) {
        LCD_Enqueue((uint8_t)(*str++), RS_BIT, 40);
    }
}

/* --- Modified Init Sequence --- */
void LCD_Init_Sequence(void) {
    uint32_t prep_time = Get_Time_us();
    while((Get_Time_us() - prep_time) < 50000);

    LCD_Enqueue_4bit(0x30, 4500);
    LCD_Enqueue_4bit(0x30, 150);
    LCD_Enqueue_4bit(0x30, 150);
    LCD_Enqueue_4bit(0x20, 40);

    LCD_Enqueue(0x28, 0, 40);
    LCD_Enqueue(0x0C, 0, 40);
    LCD_Enqueue(0x01, 0, 2000);
    LCD_Enqueue(0x06, 0, 40);
}

/* --- Hardware Peripheral Setup --- */
void TIM5_Config(void) {
    // 1. Enable TIM5 Clock on APB1
    RCC->APB1ENR |= RCC_APB1ENR_TIM5EN;

    // 2. Set Prescaler for 1us tick
    // Assuming System Clock is 168MHz, APB1 Timer clock is typically 84MHz
    // If your clock configuration uses 180MHz, change this to (90 - 1)
    TIM5->PSC = 84 - 1;

    // 3. Set Auto-Reload Register to maximum 32-bit value
    TIM5->ARR = 0xFFFFFFFF;

    // 4. Update Event Generation and Enable Timer
    TIM5->EGR |= TIM_EGR_UG;
    TIM5->CR1 |= TIM_CR1_CEN;
}

void I2C1_Config(void) {
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
    RCC->APB1ENR |= RCC_APB1ENR_I2C1EN;

    GPIOB->MODER &= ~((3 << (8 * 2)) | (3 << (9 * 2)));
    GPIOB->MODER |=  ((2 << (8 * 2)) | (2 << (9 * 2)));
    GPIOB->OTYPER |= (1 << 8) | (1 << 9);
    GPIOB->AFR[1] |= (4 << (0 * 4)) | (4 << (1 * 4));

    I2C1->CR2 = 45;
    I2C1->CCR = 37;
    I2C1->TRISE = 14;
    I2C1->CR1 |= I2C_CR1_PE;

    NVIC_SetPriority(I2C1_EV_IRQn, 0);
    NVIC_EnableIRQ(I2C1_EV_IRQn);
}

void Button_EXTI_Config(void) {
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

    GPIOC->MODER &= ~(3U << (13 * 2));
    GPIOC->PUPDR &= ~(3U << (13 * 2));

    SYSCFG->EXTICR[3] &= ~(0xFU << 4);
    SYSCFG->EXTICR[3] |= (0x2U << 4);

    EXTI->IMR |= (1 << 13);
    EXTI->RTSR |= (1 << 13);

    NVIC_SetPriority(EXTI15_10_IRQn, 10);
    NVIC_EnableIRQ(EXTI15_10_IRQn);
}

/* --- EXTI Interrupt Handler --- */
void EXTI15_10_IRQHandler(void) {
    if (EXTI->PR & (1 << 13)) {
        EXTI->PR = (1 << 13);

        static uint32_t last_pressed_time = 0;
        uint32_t current_time = Get_Time_us();

        // Time-based debounce only (Hardware RC filter handles the rest)
        if ((current_time - last_pressed_time) > 50000) {
            static uint16_t press_count = 0;
            char buffer[16];

            press_count++;

            LCD_Enqueue(0x01, 0, 2000);
            sprintf(buffer, "Pressed: %d", press_count);
            LCD_Print(buffer);

            last_pressed_time = current_time;
        }
    }
}















