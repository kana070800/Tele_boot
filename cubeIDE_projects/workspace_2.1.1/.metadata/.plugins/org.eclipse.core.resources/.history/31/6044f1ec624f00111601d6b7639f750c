/**
 * @brief Basic Timer 7 초기화 (8Hz 인터럽트)
 */
void Timer7_Init(void) {
    RCC->APB1ENR |= RCC_APB1ENR_TIM7EN;

    TIM7->PSC = 8400 - 1;               // 84MHz / 8400 = 10kHz
    TIM7->ARR = 1250 - 1;               // 10kHz / 1250 = 8Hz (125ms)

    TIM7->DIER |= TIM_DIER_UIE;
    NVIC_EnableIRQ(TIM7_IRQn);

    TIM7->CR1 |= TIM_CR1_CEN;
}

/**
 * @brief HC-SR04 GPIO 초기화
 * Trig: PA0 (Output)
 * Echo: PB0 (Input) - 수정됨
 */
void HCSR04_Init(void) {
    // GPIOA(Trig) 및 GPIOB(Echo) 클럭 활성화
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOAEN | RCC_AHB1ENR_GPIOBEN;

    // PA0 - Output mode (Trig)
    GPIOA->MODER &= ~(3 << (0 * 2));    // Reset
    GPIOA->MODER |= (1 << (0 * 2));     // General Purpose Output

    // PB0 - Input mode (Echo) - 수정됨
    GPIOB->MODER &= ~(3 << (0 * 2));    // 00: Input mode
    // PB0 내부 Pull-down 설정 (Echo 핀의 안정적인 상태 유지)
    GPIOB->PUPDR &= ~(3 << (0 * 2));
    GPIOB->PUPDR |= (2 << (0 * 2));     // 10: Pull-down
}

/**
 * @brief 초음파 센서 거리 측정
 */
float HCSR04_Read(void) {
    uint32_t count = 0;

    // 1. Trig(PA0) 10us High 펄스
    GPIOA->BSRR = GPIO_BSRR_BS0;
    Delay_us(10);
    GPIOA->BSRR = GPIO_BSRR_BR0;

    // 2. Echo(PB0)가 High가 될 때까지 대기
    while (!(GPIOB->IDR & GPIO_IDR_ID0)); // PB0 체크로 변경

    // 3. Echo(PB0)가 High인 동안 시간 측정
    while (GPIOB->IDR & GPIO_IDR_ID0) {   // PB0 체크로 변경
        count++;
        Delay_us(1);
        if(count > 30000) break; // 약 5미터 이상 무시 (Timeout)
    }

    // 4. 거리 계산 (실제 환경에 따라 보정 필요)
    // 소리 속도 340m/s -> 1cm 이동에 약 29us 소요 (왕복 58us)
    float measured = (float)count * 0.017f;

    return measured;
}

/**
 * @brief Timer 7 인터럽트 핸들러 (1초에 8번 호출)
 */
void TIM7_IRQHandler(void) {
    if (TIM7->SR & TIM_SR_UIF) {
        TIM7->SR &= ~TIM_SR_UIF;

        // 센서 읽기 및 Low Pass Filter 적용
        g_raw_distance = HCSR04_Read();
        g_distance = (alpha * g_raw_distance) + ((1.0f - alpha) * g_distance);
    }
}

/**
 * @brief 지연 함수 (168MHz HCLK 기준)
 */
void Delay_us(uint32_t us) {
    uint32_t count = us * 33; // 168MHz에서 대략적인 1us 루프 횟수
    while (count--) {
        __NOP();
    }
}

/*
 * NUCLEO-F429ZI LED
 * LD1 Green = PB0
 * LD2 Blue  = PB7
 * LD3 Red   = PB14
 */
static void GPIO_LED_Init(void)
{
    RCC->AHB1ENR |= (1 << 1);   // GPIOB clock enable
    (void)RCC->AHB1ENR;

    GPIOB->MODER &= ~((3 << (0 * 2)) |
                      (3 << (7 * 2)) |
                      (3 << (14 * 2)));

    GPIOB->MODER |=  ((1 << (0 * 2)) |
                      (1 << (7 * 2)) |
                      (1 << (14 * 2)));

    GPIOB->OTYPER &= ~((1 << 0) | (1 << 7) | (1 << 14));

    GPIOB->PUPDR &= ~((3 << (0 * 2)) |
                      (3 << (7 * 2)) |
                      (3 << (14 * 2)));

    GPIOB->ODR &= ~((1 << 0) | (1 << 7) | (1 << 14));
}

/* ===================== TIM9 Clock Calculation ===================== */

/*
 * TIM9는 APB2 timer.
 *
 * APB2 prescaler가 1이면 TIM9 clock = PCLK2
 * APB2 prescaler가 1보다 크면 TIM9 clock = PCLK2 * 2
 *
 * 현재 RCC->CFGR 값을 보고 TIM9 clock을 계산.
 */
static unsigned int Get_TIM9_TimerClock_Hz(void)
{
    unsigned int hclk = SystemCoreClock;
    unsigned int ppre2 = (RCC->CFGR >> 13) & 0x7;
    unsigned int pclk2;
    unsigned int tim_clk;

    if (ppre2 < 4)
    {
        pclk2 = hclk;
        tim_clk = pclk2;
    }
    else
    {
        unsigned int shift = ppre2 - 3;
        pclk2 = hclk >> shift;
        tim_clk = pclk2 * 2;
    }

    return tim_clk;
}

/* ===================== TIM9 PE5 PWM Init ===================== */

/*
 * PE5 = TIM9_CH1 PWM 직접 초기화
 */
static void TIM9_PWM_PE5_Init(void)
{
    unsigned int tim_clk;
    unsigned int psc;

    SystemCoreClockUpdate();
    tim_clk = Get_TIM9_TimerClock_Hz();

    /*
     * GPIOE clock enable
     */
    RCC->AHB1ENR |= (1 << 4);   // GPIOEEN
    (void)RCC->AHB1ENR;

    /*
     * PE5 Alternate Function mode
     * MODER5[1:0] = 10
     */
    GPIOE->MODER &= ~(3 << (5 * 2));
    GPIOE->MODER |=  (2 << (5 * 2));

    /*
     * PE5 AF3 = TIM9_CH1
     */
    GPIOE->AFR[0] &= ~(0xF << (5 * 4));
    GPIOE->AFR[0] |=  (0x3 << (5 * 4));

    /*
     * Push-pull, no pull, high speed
     */
    GPIOE->OTYPER &= ~(1 << 5);

    GPIOE->PUPDR &= ~(3 << (5 * 2));

    GPIOE->OSPEEDR &= ~(3 << (5 * 2));
    GPIOE->OSPEEDR |=  (2 << (5 * 2));

    /*
     * TIM9 clock enable
     * TIM9 = APB2ENR bit 16
     */
    RCC->APB2ENR |= (1 << 16);
    (void)RCC->APB2ENR;

    /*
     * Timer stop
     */
    TIM9->CR1 = 0;

    /*
     * Timer tick을 1MHz로 맞춤.
     * psc = TIM9_clock / 1MHz - 1
     */
    if (tim_clk >= 1000000)
    {
        psc = (tim_clk / 1000000) - 1;
    }
    else
    {
        psc = 0;
    }

    TIM9->PSC = psc;

    /*
     * 기본 1kHz
     * 1MHz / (999 + 1) = 1kHz
     */
    TIM9->ARR = 999;
    TIM9->CCR1 = 500;

    /*
     * PWM mode 1 on CH1
     * OC1M = 110
     * OC1PE = 1
     */
    TIM9->CCMR1 &= ~((7 << 4) | (1 << 3));
    TIM9->CCMR1 |=  (6 << 4) | (1 << 3);

    /*
     * CH1 output enable
     */
    TIM9->CCER |= (1 << 0);   // CC1E

    /*
     * Auto-reload preload enable
     */
    TIM9->CR1 |= (1 << 7);    // ARPE

    /*
     * Update event
     */
    TIM9->EGR = 1;            // UG

    Buzzer_Stop();
}

static void PE5_PWM_Mode(void)
{
    /*
     * PE5 = Alternate Function mode
     * AF3 = TIM9_CH1
     */
    GPIOE->MODER &= ~(3 << (5 * 2));
    GPIOE->MODER |=  (2 << (5 * 2));

    GPIOE->AFR[0] &= ~(0xF << (5 * 4));
    GPIOE->AFR[0] |=  (0x3 << (5 * 4));
}

static void PE5_GPIO_Low_Mode(void)
{
    /*
     * PE5를 일반 GPIO output으로 바꾸고 LOW 출력
     * 부저 OFF를 확실하게 만들기 위함
     */
    GPIOE->MODER &= ~(3 << (5 * 2));
    GPIOE->MODER |=  (1 << (5 * 2));   // output mode

    GPIOE->OTYPER &= ~(1 << 5);        // push-pull
    GPIOE->ODR &= ~(1 << 5);           // PE5 LOW
}

/* ===================== Buzzer Basic Functions ===================== */

void Buzzer_SetFreq(unsigned int freq)
{
    unsigned int timer_tick = 1000000;   // TIM9 PSC 이후 1MHz 기준
    unsigned int arr;

    if (freq == 0)
    {
        Buzzer_Stop();
        return;
    }

    arr = (timer_tick / freq) - 1;

    TIM9->ARR = arr;
    TIM9->CCR1 = (arr + 1) / 2;   // duty 50%

    TIM9->EGR = 1;                // update event
}

void Buzzer_Start(void)
{
    /*
     * PE5를 다시 TIM9_CH1 PWM 핀으로 전환
     */
    PE5_PWM_Mode();

    /*
     * CH1 output enable
     */
    TIM9->CCER |= (1 << 0);      // CC1E = 1

    /*
     * Counter enable
     */
    TIM9->CR1 |= (1 << 0);       // CEN = 1
}

void Buzzer_Stop(void)
{
    /*
     * Timer counter stop
     */
    TIM9->CR1 &= ~(1 << 0);      // CEN = 0

    /*
     * CH1 output disable
     */
    TIM9->CCER &= ~(1 << 0);     // CC1E = 0

    /*
     * Duty 0
     */
    TIM9->CCR1 = 0;

    /*
     * PE5를 GPIO LOW로 강제 전환
     */
    PE5_GPIO_Low_Mode();
}

