/**
  * @brief  Function implementing the defaultTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartDefaultTask */
void StartDefaultTask(void *argument)
{
  /* USER CODE BEGIN 5 */

  // 디버깅용 내부 변수 초기화
  uint32_t debug_counter = 0;
  float time_elapsed = 0.0f;
  const float TIME_STEP = 0.05f; // 50ms 기준 시간 증가량

  /* Infinite loop */
  for(;;)
  {
    // 1. 뮤텍스를 획득하여 데이터 오염 방지 (타임아웃 10ms)
    if (osMutexAcquire(shm_mutex, 10) == osOK)
    {
      // [1] 시퀀스 카운터 및 ID 업데이트 (패킷 유실 확인용)
      g_shm_data.module_id = debug_counter++;

      // [2] 아날로그 데이터 시뮬레이션 (사인파를 이용한 부드러운 파형 생성)
      // 예: 온도를 20.0~30.0℃ 사이에서 왕복 변경
      g_shm_data.current_temp_c = 25.0f + 5.0f * sinf(time_elapsed);

      // 예: 압력을 1000.0~1050.0 hPa 사이에서 왕복 변경 (위상차 적용)
      g_shm_data.pressure_value = 1025.0f + 25.0f * sinf(time_elapsed + 1.57f);

      // 예: RPM을 0 ~ 3000 사이에서 서서히 증가 및 초기화
      g_shm_data.current_speed_rpm = (float)((debug_counter * 50) % 3000);

      // [3] 디지털 상태 및 플래그 토글 (100회 주기로 상태 변경)
      if ((debug_counter % 100) == 0)
      {
        g_shm_data.warning_flag ^= 0x01; // XOR 연산으로 0과 1 토글
      }

      // [4] 전력 데이터 계산 (가상 연산)
      g_shm_data.reported_power_w = (g_shm_data.current_speed_rpm / 3000.0f) * 150.0f;

      // 뮤텍스 해제 (다른 송수신 태스크가 접근할 수 있도록 허용)
      osMutexRelease(shm_mutex);
    }

    // 시간 변수 업데이트
    time_elapsed += TIME_STEP;
    if (time_elapsed > 628.318f) // 약 100*2Pi 이후 오버플로 방지용 리셋
    {
      time_elapsed = 0.0f;
    }

    // [중요] 1ms(osDelay(1))는 데이터 업데이트 및 통신 주기로 너무 빠릅니다.
    // 다른 UART/CAN 송신 태스크의 주기에 맞추거나, CPU 점유율을 위해 50ms 주기로 변경을 권장합니다.
    osDelay(50);
  }
  /* USER CODE END 5 */
}

