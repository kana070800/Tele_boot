#include "stm32f4xx.h"
#include "cmsis_os.h"
#include <stdio.h>
#include "main.h"
#include "string.h"
#include "stdlib.h"
#include "semphr.h"

#define ADXL345_ADDR            0x53
#define ADXL345_REG_POWER_CTL   0x2D
#define ADXL345_REG_DATAY0      0x34

volatile int16_t accel_y = 0;

osThreadId_t sensorTaskHandle;
osThreadId_t motorTaskHandle;

const osThreadAttr_t sensorTask_attributes = { .name = "sensorTask", .stack_size = 128 * 4, .priority = osPriorityNormal };
const osThreadAttr_t motorTask_attributes  = { .name = "motorTask",  .stack_size = 128 * 4, .priority = osPriorityNormal };

void System_Clock_Init(void);
void GPIO_Init_NoHal(void);
void I2C2_Init_NoHal(void);
void TIM1_Init_NoHal(void);
void UART3_Init(void);

void I2C2_WriteRegister(uint8_t devAddr, uint8_t regAddr, uint8_t data);
void I2C2_ReadBurst(uint8_t devAddr, uint8_t regAddr, uint8_t *pData, uint8_t size);
void UART3_Send_Byte(char ch);
void UART3_Send_String(char* p);

void StartSensorTask(void *argument);
void StartMotorTask(void *argument);

int _write(int file, char *ptr, int len)
{
  for (int i = 0; i < len; i++)
  {
      UART3_Send_Byte(ptr[i]);
  }
  return len;
}

int main(void)
{
  // 하드웨어 로우레벨 초기화
  System_Clock_Init();
  GPIO_Init_NoHal();
  I2C2_Init_NoHal();
  TIM1_Init_NoHal();
  UART3_Init();

  // ADXL345 센서 초기화
  I2C2_WriteRegister(ADXL345_ADDR, ADXL345_REG_POWER_CTL, 0x08);

  // RTOS 가동 전 순수 레지스터 기반으로 UART가 나오는지 먼저 검증
  UART3_Send_String("\r\n=== Bare-metal UART Test OK ===\r\n");
  printf("=== System Booted (No HAL RTOS) ===\r\n");

  osKernelInitialize();

  sensorTaskHandle = osThreadNew(StartSensorTask, NULL, &sensorTask_attributes);
  motorTaskHandle = osThreadNew(StartMotorTask, NULL, &motorTask_attributes);

  osKernelStart();

  while (1);
}

void StartSensorTask(void *argument)
{
  uint8_t buffer[2] = {0};

  for(;;)
  {
    I2C2_ReadBurst(ADXL345_ADDR, ADXL345_REG_DATAY0, buffer, 2);
    accel_y = (int16_t)((buffer[1] << 8) | buffer[0]);

    // 실시간 출력
    printf("Accel Y: %d\r\n", accel_y);

    osDelay(20);
  }
}

void StartMotorTask(void *argument)
{
  const int16_t threshold = 30;

  for(;;)
  {
    int16_t current_y = accel_y;

    if (current_y > threshold)
    {
      GPIOC->BSRR = (1 << 7);
      TIM1->CCR1 = 500;
    }
    else if (current_y < -threshold)
    {
      GPIOC->BSRR = (1 << (7 + 16));
      TIM1->CCR1 = 500;
    }
    else
    {
      TIM1->CCR1 = 0;
    }

    osDelay(50);
  }
}

void UART3_Init(){
	// 1. 클록 인가
	RCC->AHB1ENR |= (0x1 << 3);  // GPIOD clk enable
	RCC->APB1ENR |= (0x1 << 18); // USART3 clk enable

	// 2. GPIO 핀 모드 설정 (PD8 = TX, PD9 = RX)
	GPIOD->MODER &= ~((0x3 << (8*2)) | (0x3 << (9*2)));
	GPIOD->MODER |=  ((0x2 << (8*2)) | (0x2 << (9*2)));  // AF Mode

	// 3. Alternative Function 7 (UART3) 지정
	GPIOD->AFR[1] &= ~((0xF << 0) | (0xF << 4)); // PD8, PD9 AF 영역 클리어
	GPIOD->AFR[1] |=  ((0x7 << 0) | (0x7 << 4)); // 둘 다 AF7 지정

	GPIOD->OSPEEDR |= ((0x3 << (8*2)) | (0x3 << (9*2))); // High Speed

	// 4. UART 제어 레지스터 설정
	USART3->CR1 &= ~(0x1 << 12); // M=0 (8-bit data)
	USART3->CR2 &= ~(0x3 << 12); // STOP=00 (1 Stop bit)

	// [수정 포인트 ①] 16MHz 기본 내부 클록(HSI) 기준 115200 bps 분주비 계산
	// 16,000,000 / (16 * 115200) = 8.68
	// Mantissa = 8 (0x8), Fraction = 0.68 * 16 = 10.88 -> 대략 11 (0xB)
	// 따라서 BRR = (8 << 4) | 11 = 0x8B입니다.
	// 만약 SystemClock 세팅이 잡혀서 APB1이 42MHz라면 원래 적으신 0x16D가 맞습니다.
	USART3->BRR = 0x8B;

	// 5. UART, TX, RX 전체 활성화
	USART3->CR1 |= (0x1 << 13); // UE (UART Enable)
	USART3->CR1 |= (0x3 << 2);  // TE, RE (Tx, Rx Enable)
}

// [수정 포인트 ②] 데이터 오버런 방지를 위해 TXE 상태 체크를 무조건 앞으로 배치
void UART3_Send_Byte(char ch){
	if (ch == '\n'){
		while(!(USART3->SR & (1 << 7))); // 전송 레지스터가 빌 때까지 '먼저' 대기 (TXE 확인)
		USART3->DR = '\r';               // 캐리지 리턴 전송
	}
	while(!(USART3->SR & (1 << 7)));     // 전송 레지스터가 빌 때까지 대기
	USART3->DR = ch;                     // 본래 문자 전송
}

void UART3_Send_String(char* p){
    while (*p){
        UART3_Send_Byte(*p++);
    }
}

/* 내부 기본 RC 오실레이터 유지를 위해 레지스터 초기화 가볍게 유지 */
void System_Clock_Init(void) {
    // 1. 내부 16MHz HSI 오실레이터 활성화 및 안정화 대기
    RCC->CR |= RCC_CR_HSION;
    while(!(RCC->CR & RCC_CR_HSIRDY));

    // 플래시 레이턴시 설정 (16MHz 기준으로는 사실 0WS로도 충분하나 안정화 유지)
    FLASH->ACR |= FLASH_ACR_LATENCY_5WS;

    // 2. [핵심 추가] FreeRTOS를 위한 SysTick 설정 (1ms 주기)
    // 16,000,000Hz 클록 나누기 1000 = 16000 (0x3E80)
    SysTick->LOAD = (16000000 / 1000) - 1;
    SysTick->VAL  = 0; // 카운터 초기화

    // 클록 소스 = Processor Clock(비트2), 인터럽트 활성화(비트1), 타이머 활성화(비트0)
    SysTick->CTRL = SysTick_CTRL_CLKSOURCE_Msk |
                    SysTick_CTRL_TICKINT_Msk   |
                    SysTick_CTRL_ENABLE_Msk;
}

void GPIO_Init_NoHal(void)
{
  RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN | RCC_AHB1ENR_GPIOEEN;
  GPIOC->MODER &= ~(3 << (7 * 2)); GPIOC->MODER |= (1 << (7 * 2));
  GPIOB->MODER &= ~((3 << (10 * 2)) | (3 << (11 * 2))); GPIOB->MODER |= ((2 << (10 * 2)) | (2 << (11 * 2)));
  GPIOB->OTYPER |= (1 << 10) | (1 << 11); GPIOB->AFR[1] |= (4 << ((10 - 8) * 4)) | (4 << ((11 - 8) * 4));
  GPIOE->MODER &= ~(3 << (9 * 2)); GPIOE->MODER |= (2 << (9 * 2)); GPIOE->AFR[1] |= (1 << ((9 - 8) * 4));
}

void I2C2_Init_NoHal(void)
{
  RCC->APB1ENR |= RCC_APB1ENR_I2C2EN; I2C2->CR1 |= I2C_CR1_SWRST; I2C2->CR1 &= ~I2C_CR1_SWRST;
  I2C2->CR2 |= 16; // HSI 16MHz 기준 주파수 설정
  I2C2->CCR |= 80; // 100kHz standard mode 조정 값
  I2C2->TRISE |= 17;
  I2C2->CR1 |= I2C_CR1_PE;
}

void TIM1_Init_NoHal(void)
{
  RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
  TIM1->PSC = 16 - 1;   // 16MHz 시스템 클록 기준 1MHz 타이머 클록 변환
  TIM1->ARR = 1000 - 1;
  TIM1->CCMR1 &= ~TIM_CCMR1_OC1M; TIM1->CCMR1 |= (6 << TIM_CCMR1_OC1M_Pos) | TIM_CCMR1_OC1PE;
  TIM1->CCER |= TIM_CCER_CC1E; TIM1->BDTR |= TIM_BDTR_MOE; TIM1->CR1 |= TIM_CR1_CEN;
}

void I2C2_WriteRegister(uint8_t devAddr, uint8_t regAddr, uint8_t data)
{
  while(I2C2->SR2 & I2C_SR2_BUSY); I2C2->CR1 |= I2C_CR1_START; while(!(I2C2->SR1 & I2C_SR1_SB));
  I2C2->DR = (devAddr << 1); while(!(I2C2->SR1 & I2C_SR1_ADDR)); (void)I2C2->SR2;
  while(!(I2C2->SR1 & I2C_SR1_TXE)); I2C2->DR = regAddr; while(!(I2C2->SR1 & I2C_SR1_TXE));
  I2C2->DR = data; while(!(I2C2->SR1 & I2C_SR1_BTF)); I2C2->CR1 |= I2C_CR1_STOP;
}

void I2C2_ReadBurst(uint8_t devAddr, uint8_t regAddr, uint8_t *pData, uint8_t size)
{
  while(I2C2->SR2 & I2C_SR2_BUSY); I2C2->CR1 |= I2C_CR1_START; while(!(I2C2->SR1 & I2C_SR1_SB));
  I2C2->DR = (devAddr << 1); while(!(I2C2->SR1 & I2C_SR1_ADDR)); (void)I2C2->SR2;
  while(!(I2C2->SR1 & I2C_SR1_TXE)); I2C2->DR = regAddr; while(!(I2C2->SR1 & I2C_SR1_BTF));
  I2C2->CR1 |= I2C_CR1_START; while(!(I2C2->SR1 & I2C_SR1_SB)); I2C2->DR = (devAddr << 1) | 0x01;
  while(!(I2C2->SR1 & I2C_SR1_ADDR)); (void)I2C2->SR2; I2C2->CR1 |= I2C_CR1_ACK;
  for(uint8_t i = 0; i < size; i++) {
    if(i == (size - 1)) { I2C2->CR1 &= ~I2C_CR1_ACK; I2C2->CR1 |= I2C_CR1_STOP; }
    while(!(I2C2->SR1 & I2C_SR1_RXNE)); pData[i] = I2C2->DR;
  }
}
