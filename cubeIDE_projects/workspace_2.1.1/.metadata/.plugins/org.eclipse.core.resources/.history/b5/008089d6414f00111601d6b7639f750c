/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  HAL_Init();

  SystemClock_Config();

  MX_GPIO_Init();
  MX_ETH_Init();
  MX_I2C1_Init();
  MX_I2C2_Init();
  MX_USART3_UART_Init();
  MX_USB_OTG_FS_PCD_Init();

//  GPIOB->MODER &= ~(3 << (7 * 2));
//  GPIOB->MODER |=  (1 << (7 * 2));
//  GPIOB->BSRR = (1 << 7);


  // 1. I2C 비활성화
  I2C1->CR1 &= ~(1 << 0);

  // 2. 소프트웨어 리셋 수행 (고착 상태 해제)
  I2C1->CR1 |= (1 << 15);
  for(volatile int i=0; i<100; i++); // 잠시 대기
  I2C1->CR1 &= ~(1 << 15);

  // 3. 다시 활성화
  I2C1->CR1 |= (1 << 0);
  //---------------------------
  // 1. Start
  I2C1->CR1 |= 1 << 8;
  while (!(I2C1->SR1 & (1 << 0))); // SB(Start Bit) 확인


  // 2. slave address
  I2C1->DR =  (0x27 << 1);
  while (!(I2C1->SR1 & (1 << 1))); // ADDR(주소 일치) 확인
  (void)I2C1->SR2; // ADDR 플래그 클리어


//  // 3. 레지스터 주소(0x1C) 전송
//  I2C1->DR = 0x1C;
//  while (!(I2C1->SR1 & I2C_SR1_TXE));

  // 예: LCD 화면을 싹 비우는 'Clear Display' 명령어(0x01) 전송
  uint8_t data = 0x01;
  uint8_t flags = 0x08; // Backlight ON (표준적인 I2C LCD 배낭 기준)

  // [상위 4비트 전송]
  I2C1->DR = (data & 0xF0) | flags | 0x04; // Data + EN=1
  while (!(I2C1->SR1 & (1 << 7)));         // TXE 확인 (데이터 버퍼 비었음)

  I2C1->DR = (data & 0xF0) | flags;        // Data + EN=0 (Falling Edge로 LCD가 읽음)
  while (!(I2C1->SR1 & (1 << 7)));

  // [하위 4비트 전송]
  I2C1->DR = ((data << 4) & 0xF0) | flags | 0x04; // Data + EN=1
  while (!(I2C1->SR1 & (1 << 7)));

  I2C1->DR = ((data << 4) & 0xF0) | flags;        // Data + EN=0
  while (!(I2C1->SR1 & (1 << 7)));

  while (!(I2C1->SR1 & (1 << 2))); // BTF(Byte Transfer Finished) 확인
  I2C1->CR1 |= (1 << 9);           // Stop Bit 생성

  while (1)
  {
  }

}
