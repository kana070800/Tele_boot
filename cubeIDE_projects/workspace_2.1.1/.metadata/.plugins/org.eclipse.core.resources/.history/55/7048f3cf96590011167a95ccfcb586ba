#include "main.h"
#include "cmsis_os.h"
#include "stm32f4xx_hal.h"
/* 하드웨어 핸들 선언 */
I2C_HandleTypeDef hi2c2;
TIM_HandleTypeDef hatim1;

/* FreeRTOS 태스크 핸들 */
osThreadId_t sensorTaskHandle;
const osThreadAttr_t sensorTask_attributes = {
  .name = "sensorTask",
  .stack_size = 128 * 4,
  .priority = (osPriority_t) osPriorityNormal,
};

osThreadId_t motorTaskHandle;
const osThreadAttr_t motorTask_attributes = {
  .name = "motorTask",
  .stack_size = 128 * 4,
  .priority = (osPriority_t) osPriorityNormal,
};

/* ADXL345 레지스터 주소 및 장치 주소 (소트프웨어 8비트 주소 적용) */
#define ADXL345_DEVICE_ADDR     (0x53 << 1)
#define ADXL345_REG_POWER_CTL   0x2D
#define ADXL345_REG_DATAX0      0x32
#define ADXL345_REG_DATAY0      0x34

/* 전역 공유 변수 (센서 가속도 값) */
volatile int16_t accel_y = 0;

/* 태스크 함수 프로토타입 */
void StartSensorTask(void *argument);
void StartMotorTask(void *argument);
void ADXL345_Init(void);

int main(void)
{
  HAL_Init();
  SystemClock_Config();

  /* MX로 생성된 주변장치 초기화 함수들 (I2C2, TIM1, GPIO 등) */
  MX_GPIO_Init();
  MX_I2C2_Init();
  MX_TIM1_Init();

  /* ADXL345 센서 초기화 (측정 모드 활성화) */
  ADXL345_Init();

  /* PWM 타이머 시작 */
  HAL_TIM_PWM_Start(&hatim1, TIM_CHANNEL_1);

  /* RTOS 커널 초기화 */
  osKernelInitialize();

  /* 태스크 등록 */
  sensorTaskHandle = osThreadNew(StartSensorTask, NULL, &sensorTask_attributes);
  motorTaskHandle = osThreadNew(StartMotorTask, NULL, &motorTask_attributes);

  /* RTOS 스케줄러 시작 */
  osKernelStart();

  while (1)
  {
      // RTOS 가동 후에는 이 루프에 진입하지 않습니다.
  }
}

/* ====================================================================
   [Task 1] ADXL345 데이터 읽기 태스크
   ==================================================================== */
void StartSensorTask(void *argument)
{
  uint8_t rec_data[2];

  for(;;)
  {
    /* Y축 가속도 데이터 2바이트 읽기 (DATAY0, DATAY1) */
    if (HAL_I2C_Mem_Read(&hi2c2, ADXL345_DEVICE_ADDR, ADXL345_REG_DATAY0, I2C_MEMADD_SIZE_8BIT, rec_data, 2, 100) == HAL_OK)
    {
        /* 상위 바이트와 하위 바이트 결합하여 16비트 정수 생성 */
        accel_y = (int16_t)((rec_data[1] << 8) | rec_data[0]);
    }

    /* 20ms 주기로 데이터 폴링 (50Hz) */
    osDelay(20);
  }
}

/* ====================================================================
   [Task 2] 모터 전후진 제어 태스크
   ==================================================================== */
void StartMotorTask(void *argument)
{
  /* 데드존(Deadzone) 설정: 미세한 흔들림에 모터가 반응하지 않도록 함 */
  const int16_t threshold = 30;

  for(;;)
  {
    // 정적 로컬 변수로 현재 센서 값을 복사해와 사용 (스레드 안전성 확보 용도)
    int16_t current_y = accel_y;

    if (current_y > threshold)
    {
      /* 전진 제어 */
      HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, GPIO_PIN_SET); // 방향핀 HIGH
      __HAL_TIM_SET_COMPARE(&hatim1, TIM_CHANNEL_1, 500);  // PWM Duty 50% (타이머 ARR이 1000일 때)
    }
    else if (current_y < -threshold)
    {
      /* 후진 제어 */
      HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, GPIO_PIN_RESET); // 방향핀 LOW
      __HAL_TIM_SET_COMPARE(&hatim1, TIM_CHANNEL_1, 500);   // PWM Duty 50%
    }
    else
    {
      /* 정지 (데드존 범위 내) */
      __HAL_TIM_SET_COMPARE(&hatim1, TIM_CHANNEL_1, 0);     // PWM Duty 0%
    }

    /* 50ms 주기로 모터 상태 업데이트 */
    osDelay(50);
  }
}

/* ====================================================================
   ADXL345 초기화 함수
   ==================================================================== */
void ADXL345_Init(void)
{
  uint8_t make_measure = 0x08; // Measure 비트 활성화 (0x08)

  // Power_CTL 레지스터에 0x08을 써서 측정 모드로 진입시킴
  HAL_I2C_Mem_Write(&hi2c2, ADXL345_DEVICE_ADDR, ADXL345_REG_POWER_CTL, I2C_MEMADD_SIZE_8BIT, &make_measure, 1, 100);
}
