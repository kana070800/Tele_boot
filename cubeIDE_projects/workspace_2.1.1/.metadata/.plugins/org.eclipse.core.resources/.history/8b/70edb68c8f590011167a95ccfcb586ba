/* Private define ------------------------------------------------------------*/
#define ADXL345_ADDR        (0x53 << 1)
#define ADXL345_DEVID       0x00
#define ADXL345_POWER_CTL   0x2D
#define ADXL345_DATA_FORMAT 0x31
#define ADXL345_DATAX0      0x32

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim14;
UART_HandleTypeDef huart3;

volatile int16_t g_adxl_y_raw = 0;
volatile int16_t g_motor_signal_y = 0;

/* I2C2 인터럽트 동기화용 변수 및 구조체 */
static TaskHandle_t xI2C2TaskToNotify = NULL;

typedef struct {
    uint8_t dev_addr;
    uint8_t reg_addr;
    uint8_t *pData;
    uint32_t len;
    uint32_t index;
    enum { I2C_WRITE, I2C_READ } mode;
    volatile int32_t status; // 0: 성공, 마이너스: 에러
} I2C2_Transfer_t;

static volatile I2C2_Transfer_t g_i2c2_xfer;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
static void MX_TIM14_Init(void);

void Uart3_Printf(char *fmt, ...);
void Motor_Control(float angle);

/* 프리RTOS 전용 I2C2 드라이버 및 태스크 프로토타입 */
void I2C2_PB10_11_init(void);
int I2C2_Write_Reg_IT(uint8_t dev_addr, uint8_t reg_addr, uint8_t data);
int I2C2_Read_Buffer_IT(uint8_t dev_addr, uint8_t reg_addr, uint8_t *pData, uint32_t len);
int ADXL345_Init_IT(void);
int ADXL345_Read_Raw_IT(int16_t *x, int16_t *y, int16_t *z);
void vADXL_MotorControlTask(void *pvParameters);

/* Main Program --------------------------------------------------------------*/
int main(void)
{
  /* MCU 초기화 및 주변장치 설정 */
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_USART3_UART_Init();
  MX_TIM14_Init();

  /* I2C2 하드웨어 및 인터럽트 설정 */
  I2C2_PB10_11_init();

  /* 모터 PWM 시작 */
  HAL_TIM_PWM_Start(&htim14, TIM_CHANNEL_1);

  Uart3_Printf("System Initialized. Preparing FreeRTOS Task...\r\n");

  /* FreeRTOS 태스크 생성 */
  BaseType_t xReturned = xTaskCreate(
      vADXL_MotorControlTask,
      "ADXL_Motor_Task",
      256,                    // 스택 크기 (Word 단위)
      NULL,
      tskIDLE_PRIORITY + 2,   // 우선순위
      NULL
  );

  if (xReturned != pdPASS) {
      Uart3_Printf("Task Creation Failed\r\n");
      Error_Handler();
  }

  /* 커널 스케줄러 실행 (이 시점부터 태스크가 구동됨) */
  vTaskStartScheduler();

  /* 정상 구동 시 이 라인 아래로 내려오지 않음 */
  while (1)
  {
  }
}

/* ===================== FreeRTOS ADXL & 모터 제어 독립 태스크 ===================== */
void vADXL_MotorControlTask(void *pvParameters)
{
    int16_t x, y, z;

    // 태스크 시작 시 Non-blocking 방식으로 가속도 센서 초기화
    if (ADXL345_Init_IT() != 0) {
        Uart3_Printf("[Task] ADXL345 Init Fault!\r\n");
    } else {
        Uart3_Printf("[Task] ADXL345 Init Success!\r\n");
    }

    for (;;)
    {
        // 6바이트 연속 읽기(Burst Read) 인터럽트 구동
        if (ADXL345_Read_Raw_IT(&x, &y, &z) == 0)
        {
            g_adxl_y_raw = y;
            g_motor_signal_y = y;

            // 읽어온 가속도 데이터 기반으로 모터 PWM 제어
            Motor_Control((float)g_motor_signal_y);

            Uart3_Printf("[Task] Y: %d -> Motor Controlled\r\n", g_adxl_y_raw);
        }
        else
        {
            Uart3_Printf("[Task] Sensor Read Failed (Bus Busy/Error)\r\n");
        }

        /* 10ms 동안 Task를 Blocked 상태로 만들어 CPU 권한을 양보 */
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

/* ===================== 리팩토링된 Non-blocking I2C2 드라이버 ===================== */
void I2C2_PB10_11_init(void)
{
	RCC->APB1ENR |= RCC_APB1ENR_I2C2EN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;

	GPIOB->MODER = (GPIOB->MODER & ~(0xF<<20)) | (0xA<<20);
	GPIOB->OTYPER |= (0x3<<10);
	GPIOB->OSPEEDR  = (GPIOB->OSPEEDR  & ~(0xF<<20)) | (0xA<<20);
	GPIOB->PUPDR  = (GPIOB->PUPDR  & ~(0xF<<20)) | (0x5<<20);

	GPIOB->AFR[1] &= ~(0xFF<<8);
	GPIOB->AFR[1] |= (0x44<<8);

	RCC->APB1RSTR |=  RCC_APB1RSTR_I2C2RST;
	RCC->APB1RSTR &= ~RCC_APB1RSTR_I2C2RST;

	I2C2->CR1 &= ~I2C_CR1_PE;
	I2C2->CR2 &= ~I2C_CR2_FREQ;
	I2C2->CR2 |= 42; // APB1 = 42MHz

	I2C2->CCR = 210;  // Standard mode 100kHz
	I2C2->TRISE = 43;
	I2C2->CR1 |= I2C_CR1_ACK;
	I2C2->CR1 |= I2C_CR1_PE;

    /* FreeRTOS 호환이 가능한 중하위 인터럽트 우선순위(6) 설정 및 활성화 */
    NVIC_SetPriority(I2C2_EV_IRQn, 6);
    NVIC_EnableIRQ(I2C2_EV_IRQn);
    NVIC_SetPriority(I2C2_ER_IRQn, 6);
    NVIC_EnableIRQ(I2C2_ER_IRQn);
}

int I2C2_Write_Reg_IT(uint8_t dev_addr, uint8_t reg_addr, uint8_t data)
{
    if (I2C2->SR2 & I2C_SR2_BUSY) return -1;

    xI2C2TaskToNotify = xTaskGetCurrentTaskHandle();
    static uint8_t w_buf;
    w_buf = data;

    g_i2c2_xfer.dev_addr  = dev_addr;
    g_i2c2_xfer.reg_addr  = reg_addr;
    g_i2c2_xfer.pData     = &w_buf;
    g_i2c2_xfer.len       = 1;
    g_i2c2_xfer.index     = 0;
    g_i2c2_xfer.mode      = I2C_WRITE;
    g_i2c2_xfer.status    = 0;

    I2C2->CR2 |= (I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
    I2C2->CR1 |= I2C_CR1_START;

    // 인터럽트 완료 알림이 올 때까지 태스크 Block (최대 50ms 대기)
    if (ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(50)) == 0) {
        I2C2->CR1 |= I2C_CR1_STOP;
        I2C2->CR2 &= ~(I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
        return -2; // 타임아웃
    }

    I2C2->CR2 &= ~(I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
    return g_i2c2_xfer.status;
}

int I2C2_Read_Buffer_IT(uint8_t dev_addr, uint8_t reg_addr, uint8_t *pData, uint32_t len)
{
    if (I2C2->SR2 & I2C_SR2_BUSY) return -1;
    if (len == 0) return 0;

    xI2C2TaskToNotify = xTaskGetCurrentTaskHandle();

    g_i2c2_xfer.dev_addr  = dev_addr;
    g_i2c2_xfer.reg_addr  = reg_addr;
    g_i2c2_xfer.pData     = pData;
    g_i2c2_xfer.len       = len;
    g_i2c2_xfer.index     = 0;
    g_i2c2_xfer.mode      = I2C_READ;
    g_i2c2_xfer.status    = 0;

    I2C2->CR2 |= (I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
    I2C2->CR1 |= I2C_CR1_START;

    // 데이터가 다 수신될 때까지 태스크 Block (최대 50ms 대기)
    if (ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(50)) == 0) {
        I2C2->CR1 |= I2C_CR1_STOP;
        I2C2->CR2 &= ~(I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
        return -2; // 타임아웃
    }

    I2C2->CR2 &= ~(I2C_CR2_ITEVTEN | I2C_CR2_ITBUFEN | I2C_CR2_ITERREN);
    return g_i2c2_xfer.status;
}

int ADXL345_Init_IT(void)
{
    uint8_t id = 0;
    int ret = I2C2_Read_Buffer_IT(ADXL345_ADDR, ADXL345_DEVID, &id, 1);
    if (ret < 0 || id != 0xE5) {
        return -1;
    }
    I2C2_Write_Reg_IT(ADXL345_ADDR, ADXL345_DATA_FORMAT, 0x08); // Full Resolution, +/-2g
    I2C2_Write_Reg_IT(ADXL345_ADDR, ADXL345_POWER_CTL, 0x08);   // Measure Mode On
    return 0;
}

int ADXL345_Read_Raw_IT(int16_t *x, int16_t *y, int16_t *z)
{
    uint8_t raw_buf[6] = {0};
    int ret = I2C2_Read_Buffer_IT(ADXL345_ADDR, ADXL345_DATAX0, raw_buf, 6);
    if (ret < 0) return ret;

    *x = (int16_t)((raw_buf[1] << 8) | raw_buf[0]);
    *y = (int16_t)((raw_buf[3] << 8) | raw_buf[2]);
    *z = (int16_t)((raw_buf[5] << 8) | raw_buf[4]);
    return 0;
}

/* ===================== I2C2 Interrupt Service Routine (ISR) ===================== */
void I2C2_EV_IRQHandler(void)
{
    uint32_t sr1 = I2C2->SR1;
    uint32_t sr2 = 0;
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    // 1. START 신호 생성 완료 (SB) -> 슬레이브 주소(Write) 전송
    if (sr1 & I2C_SR1_SB) {
        I2C2->DR = (g_i2c2_xfer.dev_addr & ~0x01);
    }
    // 2. 주소 전송 완료 응답 (ADDR) 클리어 처리
    else if (sr1 & I2C_SR1_ADDR) {
        sr2 = I2C2->SR2;
        (void)sr2;

        if (g_i2c2_xfer.mode == I2C_READ) {
            if (g_i2c2_xfer.len == 1) {
                I2C2->CR1 &= ~I2C_CR1_ACK;
                I2C2->CR1 |= I2C_CR1_STOP;
            }
        } else {
            I2C2->DR = g_i2c2_xfer.reg_addr; // 레지스터 주소 전송
        }
    }
    // 3. 데이터 송신 버퍼 비어있음 (TXE)
    else if (sr1 & I2C_SR1_TXE) {
        if (g_i2c2_xfer.mode == I2C_WRITE) {
            if (g_i2c2_xfer.index < g_i2c2_xfer.len) {
                I2C2->DR = g_i2c2_xfer.pData[g_i2c2_xfer.index++];
            }
        } else {
            // Read용 레지스터 주소 전송이 완료된 직후(BTF), Repeated START 조건 생성
            if (sr1 & I2C_SR1_BTF) {
                I2C2->CR1 |= I2C_CR1_START;
                g_i2c2_xfer.mode = I2C_READ;
                I2C2->DR = (g_i2c2_xfer.dev_addr | 0x01); // 슬레이브 주소(Read) 전송
            }
        }
    }
    // 4. 데이터 수신 완료 (RXNE)
    else if (sr1 & I2C_SR1_RXNE) {
        if (g_i2c2_xfer.mode == I2C_READ) {
            uint32_t idx = g_i2c2_xfer.index;
            g_i2c2_xfer.pData[idx] = I2C2->DR;
            g_i2c2_xfer.index++;

            if (g_i2c2_xfer.index == g_i2c2_xfer.len - 1) {
                I2C2->CR1 &= ~I2C_CR1_ACK;
                I2C2->CR1 |= I2C_CR1_STOP;
            }
            else if (g_i2c2_xfer.index >= g_i2c2_xfer.len) {
                I2C2->CR1 |= I2C_CR1_ACK;
                g_i2c2_xfer.status = 0;

                // 통신이 완전히 종료되었으므로 Blocked 상태의 태스크를 깨움
                if (xI2C2TaskToNotify != NULL) {
                    vTaskNotifyGiveFromISR(xI2C2TaskToNotify, &xHigherPriorityTaskWoken);
                    xI2C2TaskToNotify = NULL;
                }
            }
        }
    }

    // 쓰기 작업 최종 완료(BTF) 검증 및 태스크 깨우기
    if (g_i2c2_xfer.mode == I2C_WRITE && (sr1 & I2C_SR1_BTF)) {
        if (g_i2c2_xfer.index >= g_i2c2_xfer.len) {
            I2C2->CR1 |= I2C_CR1_STOP;
            g_i2c2_xfer.status = 0;

            if (xI2C2TaskToNotify != NULL) {
                vTaskNotifyGiveFromISR(xI2C2TaskToNotify, &xHigherPriorityTaskWoken);
                xI2C2TaskToNotify = NULL;
            }
        }
    }

    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

void I2C2_ER_IRQHandler(void)
{
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;

    // 에러 플래그 클리어 및 버스 정지
    I2C2->SR1 &= ~(I2C_SR1_AF | I2C_SR1_BERR | I2C_SR1_ARLO);
    I2C2->CR1 |= I2C_CR1_STOP;
    g_i2c2_xfer.status = -3;

    // 에러가 났을 때도 태스크가 무한 대기하지 않도록 강제로 깨움
    if (xI2C2TaskToNotify != NULL) {
        vTaskNotifyGiveFromISR(xI2C2TaskToNotify, &xHigherPriorityTaskWoken);
        xI2C2TaskToNotify = NULL;
    }
    portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
}

/* ===================== 모터 및 유틸리티 제어 함수 ===================== */
void Motor_Control(float angle)
{
    if(angle >= -100 && angle <= 100) {
        __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 1500);
    }
    else if(angle > 100 && angle <= 200) {
        __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 1700);
    }
    else if(angle < -100 && angle >= -200) {
        __HAL_TIM_SET_COMPARE(&htim14, TIM_CHANNEL_1, 1300);
    }
}

void UART3_Send_Byte(char ch){
  if (ch=='\r'){
      USART3->DR = 0x0a;
      while (((USART3->SR >> 7)&0x1)==0);
      USART3->DR = 0x0d;
      while (((USART3->SR >> 7)&0x1)==0);
  }
  USART3->DR = ch;
  while (((USART3->SR >> 7)&0x1)==0);
}

void UART3_Send_String(char* p){
    while (*p){
        UART3_Send_Byte(*p++);
    }
}

void Uart3_Printf(char *fmt,...)
{
  va_list ap;
  char string[256];
  va_start(ap,fmt);
  vsprintf(string,fmt,ap);
  va_end(ap);
  UART3_Send_String(string);
}

