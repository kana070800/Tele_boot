#include "stm32f4xx.h"
#include "cmsis_os.h"
#include <stdio.h>
#include "main.h"
#include "string.h"
#include "stdlib.h"
#include "semphr.h"

#define ADXL345_ADDR            0x53
#define ADXL345_REG_POWER_CTL   0x2D
#define ADXL345_REG_DATAY0      0x34

volatile int16_t accel_y = 0;

osThreadId_t sensorTaskHandle;
osThreadId_t motorTaskHandle;

const osThreadAttr_t sensorTask_attributes = { .name = "sensorTask", .stack_size = 128 * 4, .priority = osPriorityNormal };
const osThreadAttr_t motorTask_attributes  = { .name = "motorTask",  .stack_size = 128 * 4, .priority = osPriorityNormal };

/* 함수 프로토타입 선언 */
void SystemClock_Config(void);
void GPIO_Init_NoHal(void);
void I2C2_Init_NoHal(void);
void TIM1_Init_NoHal(void);
void UART3_Init(void);

void I2C2_WriteRegister(uint8_t devAddr, uint8_t regAddr, uint8_t data);
void I2C2_ReadBurst(uint8_t devAddr, uint8_t regAddr, uint8_t *pData, uint8_t size);
void UART3_Send_Byte(char ch);
void UART3_Send_String(char* p);

void StartSensorTask(void *argument);
void StartMotorTask(void *argument);

/* printf 연동을 위한 함수 재정의 */
int _write(int file, char *ptr, int len)
{
  for (int i = 0; i < len; i++)
  {
      UART3_Send_Byte(ptr[i]);
  }
  return len;
}

int main(void)
{
  /* 1. 제공해주신 외부 HSE 기반 168MHz 클록 설정 가동 */
  SystemClock_Config();

  /* 2. 레지스터 기반 주변 장치 초기화 */
  GPIO_Init_NoHal();
  I2C2_Init_NoHal();
  TIM1_Init_NoHal();
  UART3_Init();

  /* 3. ADXL345 센서 초기화 (Measure 모드 On) */
  I2C2_WriteRegister(ADXL345_ADDR, ADXL345_REG_POWER_CTL, 0x08);

  /* [검증] 스케줄러 들어가기 전 하드웨어 출력선 체크 */
  UART3_Send_String("\r\n=================================\r\n");
  UART3_Send_String("  UART3 Bare-Metal Clock 168MHz  \r\n");
  UART3_Send_String("=================================\r\n");
  printf("System Booted (No HAL RTOS)\r\n");

  /* 4. FreeRTOS 초기화 및 태스크 커널 생성 */
  osKernelInitialize();

  sensorTaskHandle = osThreadNew(StartSensorTask, NULL, &sensorTask_attributes);
  motorTaskHandle = osThreadNew(StartMotorTask, NULL, &motorTask_attributes);

  /* 5. OS 스케줄러 가동 */
  osKernelStart();

  while (1);
}

/* ====================================================================
   [Task 1] ADXL345 센서 읽기 및 시리얼 화면 출력
   ==================================================================== */
void StartSensorTask(void *argument)
{
  uint8_t buffer[2] = {0};

  for(;;)
  {
    I2C2_ReadBurst(ADXL345_ADDR, ADXL345_REG_DATAY0, buffer, 2);
    accel_y = (int16_t)((buffer[1] << 8) | buffer[0]);

    // 실시간 출력
    printf("Accel Y: %d\r\n", accel_y);

    osDelay(20); // 20ms 주기 대기
  }
}

/* ====================================================================
   [Task 2] 모터 레지스터 직접 제어 (PWM 변경)
   ==================================================================== */
void StartMotorTask(void *argument)
{
  const int16_t threshold = 30;

  for(;;)
  {
    int16_t current_y = accel_y;

    if (current_y > threshold)
    {
      GPIOC->BSRR = (1 << 7); // 전진: PC7 HIGH
      TIM1->CCR1 = 500;       // Duty 50%
    }
    else if (current_y < -threshold)
    {
      GPIOC->BSRR = (1 << (7 + 16)); // 후진: PC7 LOW
      TIM1->CCR1 = 500;
    }
    else
    {
      TIM1->CCR1 = 0;         // 정지
    }

    osDelay(50);
  }
}

/* ====================================================================
   주변장치 드라이버 로우레벨 제어 (수식 재연산 반영)
   ==================================================================== */
void UART3_Init(){
	RCC->AHB1ENR |= (0x1 << 3);  // GPIOD 클록 활성화
	RCC->APB1ENR |= (0x1 << 18); // USART3 클록 활성화

	// PD8(TX), PD9(RX) AF 모드로 설정
	GPIOD->MODER &= ~((0x3 << (8*2)) | (0x3 << (9*2)));
	GPIOD->MODER |=  ((0x2 << (8*2)) | (0x2 << (9*2)));

	// AF7 (USART3) 레지스터 정밀 클리어 후 핀 매핑
	GPIOD->AFR[1] &= ~((0xF << 0) | (0xF << 4));
	GPIOD->AFR[1] |=  ((0x7 << 0) | (0x7 << 4));

	GPIOD->OSPEEDR |= ((0x3 << (8*2)) | (0x3 << (9*2))); // 고속 설정

	USART3->CR1 &= ~(0x1 << 12); // 데이터 8비트
	USART3->CR2 &= ~(0x3 << 12); // 1 스톱비트

	// [수식 계산] 제공해주신 클록 세팅 기준 APB1 클록 = 42MHz
	// 42,000,000 / (16 * 115200) = 22.786
	// Mantissa = 22 (0x16), Fraction = 0.786 * 16 = 12.57 -> 반올림하여 13 (0xD)
	// BRR = (22 << 4) | 13 = 0x16D
	USART3->BRR = 0x16D;

	USART3->CR1 |= (0x1 << 13); // UART 모듈 온 (UE)
	USART3->CR1 |= (0x3 << 2);  // TX, RX 라인 온 (TE, RE)
}

void UART3_Send_Byte(char ch){
	if (ch == '\n'){
		while(!(USART3->SR & (1 << 7))); // TXE가 1이 될 때까지 대기
		USART3->DR = '\r';
	}
	while(!(USART3->SR & (1 << 7)));
	USART3->DR = ch;
}

void UART3_Send_String(char* p){
    while (*p){
        UART3_Send_Byte(*p++);
    }
}

void GPIO_Init_NoHal(void)
{
  RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN | RCC_AHB1ENR_GPIOCEN | RCC_AHB1ENR_GPIOEEN;
  GPIOC->MODER &= ~(3 << (7 * 2)); GPIOC->MODER |= (1 << (7 * 2));
  GPIOB->MODER &= ~((3 << (10 * 2)) | (3 << (11 * 2))); GPIOB->MODER |= ((2 << (10 * 2)) | (2 << (11 * 2)));
  GPIOB->OTYPER |= (1 << 10) | (1 << 11); GPIOB->AFR[1] |= (4 << ((10 - 8) * 4)) | (4 << ((11 - 8) * 4));
  GPIOE->MODER &= ~(3 << (9 * 2)); GPIOE->MODER |= (2 << (9 * 2)); GPIOE->AFR[1] |= (1 << ((9 - 8) * 4));
}

void I2C2_Init_NoHal(void)
{
  RCC->APB1ENR |= RCC_APB1ENR_I2C2EN;
  I2C2->CR1 |= I2C_CR1_SWRST;
  I2C2->CR1 &= ~I2C_CR1_SWRST;

  // [수식 계산] APB1 버스 클록 주파수 = 42MHz 반영
  I2C2->CR2 |= 42;
  I2C2->CCR |= 210; // 100kHz Standard 모드 클록 분주 조정 값
  I2C2->TRISE |= 43;
  I2C2->CR1 |= I2C_CR1_PE;
}

void TIM1_Init_NoHal(void)
{
  RCC->APB2ENR |= RCC_APB2ENR_TIM1EN;
  // [수식 계산] TIM1은 APB2 버스(SYSCLK가 168MHz이므로 APB2 분주기 /2를 거쳐 84MHz 타이머 내부 倍수 적용 = 168MHz 타이머 클록 적용)
  TIM1->PSC = 168 - 1;   // 168MHz 소스를 1MHz 타이머 주기로 분주
  TIM1->ARR = 1000 - 1;  // PWM 주파수 정밀 1kHz 매칭
  TIM1->CCMR1 &= ~TIM_CCMR1_OC1M; TIM1->CCMR1 |= (6 << TIM_CCMR1_OC1M_Pos) | TIM_CCMR1_OC1PE;
  TIM1->CCER |= TIM_CCER_CC1E; TIM1->BDTR |= TIM_BDTR_MOE; TIM1->CR1 |= TIM_CR1_CEN;
}

void I2C2_WriteRegister(uint8_t devAddr, uint8_t regAddr, uint8_t data)
{
  while(I2C2->SR2 & I2C_SR2_BUSY); I2C2->CR1 |= I2C_CR1_START; while(!(I2C2->SR1 & I2C_SR1_SB));
  I2C2->DR = (devAddr << 1); while(!(I2C2->SR1 & I2C_SR1_ADDR)); (void)I2C2->SR2;
  while(!(I2C2->SR1 & I2C_SR1_TXE)); I2C2->DR = regAddr; while(!(I2C2->SR1 & I2C_SR1_TXE));
  I2C2->DR = data; while(!(I2C2->SR1 & I2C_SR1_BTF)); I2C2->CR1 |= I2C_CR1_STOP;
}

void I2C2_ReadBurst(uint8_t devAddr, uint8_t regAddr, uint8_t *pData, uint8_t size)
{
  while(I2C2->SR2 & I2C_SR2_BUSY); I2C2->CR1 |= I2C_CR1_START; while(!(I2C2->SR1 & I2C_SR1_SB));
  I2C2->DR = (devAddr << 1); while(!(I2C2->SR1 & I2C_SR1_ADDR)); (void)I2C2->SR2;
  while(!(I2C2->SR1 & I2C_SR1_TXE)); I2C2->DR = regAddr; while(!(I2C2->SR1 & I2C_SR1_BTF));
  I2C2->CR1 |= I2C_CR1_START; while(!(I2C2->SR1 & I2C_SR1_SB)); I2C2->DR = (devAddr << 1) | 0x01;
  while(!(I2C2->SR1 & I2C_SR1_ADDR)); (void)I2C2->SR2; I2C2->CR1 |= I2C_CR1_ACK;
  for(uint8_t i = 0; i < size; i++) {
    if(i == (size - 1)) { I2C2->CR1 &= ~I2C_CR1_ACK; I2C2->CR1 |= I2C_CR1_STOP; }
    while(!(I2C2->SR1 & I2C_SR1_RXNE)); pData[i] = I2C2->DR;
  }
}

/* 제공된 정밀 클록 함수 본문 */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_BYPASS;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 4;
  RCC_OscInitStruct.PLL.PLLN = 168;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = 7;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    while(1); // 베어메탈용 에러 트랩 간소화
  }

  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_5) != HAL_OK)
  {
    while(1);
  }
}
