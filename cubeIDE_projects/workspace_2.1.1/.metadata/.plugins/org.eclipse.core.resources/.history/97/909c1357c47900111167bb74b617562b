#define RX_BUF_SIZE 256
#define TX_BUF_SIZE 256

volatile char rx_buffer[RX_BUF_SIZE];
volatile uint16_t rx_head = 0;
volatile uint16_t rx_tail = 0;

volatile char tx_buffer[TX_BUF_SIZE];
volatile uint16_t tx_head = 0;
volatile uint16_t tx_tail = 0;

extern SemaphoreHandle_t shm_mutex;
extern SystemSharedData_t RPi_Shared_Data;

// 하드웨어 UART3 초기화 (기존 성공하신 레지스터 설정 유지)
void UART3_Init(void) {
    RCC->AHB1ENR |= (0x1 << 3);  // GPIOD clk enable
    RCC->APB1ENR |= (0x1 << 18); // UART3 clk enable

    GPIOD->MODER &= ~((0x3 << 8*2) | (0x3 << 9*2));
    GPIOD->MODER |=  ((0x2 << 8*2) | (0x2 << 9*2));  // AF mode
    GPIOD->AFR[1] = ((GPIOD->AFR[1] & ~(0xff<<0)) | (0x77<<0));
    GPIOD->OSPEEDR |= ((0x3 << 8*2) | (0x3 << 9*2));

    USART3->CR1 |= (0x1 << 13);  // UART3 enable
    USART3->CR1 &= ~(0x1 << 12); // 8bit length set
    USART3->CR2 &= ~(0x3 << 12); // stop bit 1 length
    USART3->BRR = 0x16D;         // 42MHz 기준 115200

    USART3->CR1 |= (0x1 << 5);   // RXNEIE 활성화
    USART3->CR1 &= ~(0x1 << 7);  // TXEIE 초기 비활성화

    NVIC_SetPriority(USART3_IRQn, 5); // FreeRTOS 안전 우선순위
    NVIC_EnableIRQ(USART3_IRQn);

    USART3->CR1 |= (0x3 << 2);   // Tx, Rx Enable
}

// 인터럽트 1Byte 송신
void UART3_Send_Byte_IT(char ch) {
    uint16_t next_head = (tx_head + 1) % TX_BUF_SIZE;
    while (next_head == tx_tail); // 버퍼 Full 대기

    tx_buffer[tx_head] = ch;
    tx_head = next_head;
    USART3->CR1 |= (0x1 << 7); // TXEIE 활성화
}

// 인터럽트 핸들러
void USART3_IRQHandler(void) {
    uint32_t sr = USART3->SR;
    uint32_t cr1 = USART3->CR1;

    // 수신 인터럽트
    if ((sr & (0x1 << 5)) && (cr1 & (0x1 << 5))) {
        char rx_data = (char)(USART3->DR & 0xFF);
        uint16_t next_head = (rx_head + 1) % RX_BUF_SIZE;
        if (next_head != rx_tail) {
            rx_buffer[rx_head] = rx_data;
            rx_head = next_head;
        }
    }

    // 송신 인터럽트
    if ((sr & (0x1 << 7)) && (cr1 & (0x1 << 7))) {
        if (tx_head != tx_tail) {
            USART3->DR = tx_buffer[tx_tail];
            tx_tail = (tx_tail + 1) % TX_BUF_SIZE;
        } else {
            USART3->CR1 &= ~(0x1 << 7);
        }
    }
}

// 링 버퍼에 쌓인 데이터 바이트 수 확인
static uint16_t Get_RX_Buffer_Count(void) {
    if (rx_head >= rx_tail) return rx_head - rx_tail;
    return (RX_BUF_SIZE - rx_tail) + rx_head;
}

// 링 버퍼에서 1바이트 꺼내기 (Non-blocking)
static uint8_t Pop_RX_Byte(uint8_t *byte) {
    if (rx_head == rx_tail) return 0;
    *byte = rx_buffer[rx_tail];
    rx_tail = (rx_tail + 1) % RX_BUF_SIZE;
    return 1;
}

// 통신 Task 초기화
void UART_Task_Init(void) {
    UART3_Init();
}

#define RX_SOF 0xBB  // 패킷 시작 바이트 정의
void StartUARTTask(void *argument) {
    (void)argument;
    TickType_t xLastWakeTime = xTaskGetTickCount();
    const TickType_t xFrequency = pdMS_TO_TICKS(50);

    // 수신용 임시 버퍼 (문자열 처리를 위해)
    static char rx_line_buf[128];
    static uint8_t rx_line_idx = 0;

    for(;;) {
        /* [1. 수신 처리] 텍스트 기반 파싱 (개행 문자 \n 까지 수집) */
        while (Get_RX_Buffer_Count() > 0) {
            uint8_t byte;
            Pop_RX_Byte(&byte);

            if (byte == '\n') { // 패킷 종료 문자 확인
                rx_line_buf[rx_line_idx] = '\0'; // 문자열 종료

                // sscanf를 이용한 데이터 파싱
                uint32_t rcv_id
				ModuleType_t rcv_type;
                uint32_t rcv_warn;
                uint32_t rcv_pwr, rcv_tmp, rcv_rpm;

                // 포맷: ID:123,TYP:1,PWR:50.0,TMP:25.0,RPM:1000.0,WRN:0
                int items = sscanf(rx_line_buf, "ID:%u,TYP:%u,PWR:%u,TMP:%u,RPM:%u,WRN:%u",
                                   &rcv_id, &rcv_type, &rcv_pwr, &rcv_tmp, &rcv_rpm, &rcv_warn);

                if (items == 6) { // 6개 데이터가 모두 정상적으로 파싱되었을 때만 반영
                    if (shm_mutex != NULL && xSemaphoreTake(shm_mutex, pdMS_TO_TICKS(10)) == pdTRUE) {
                        RPi_Shared_Data.module_id        = (uint32_t)rcv_id;
                        RPi_Shared_Data.module_type      = (ModuleType_t)rcv_type;
                        RPi_Shared_Data.granted_power_w  = rcv_pwr;
                        RPi_Shared_Data.target_temp_c    = rcv_tmp;
                        RPi_Shared_Data.target_speed_rpm = rcv_rpm;
                        RPi_Shared_Data.warning_flag     = (uint8_t)rcv_warn;
                        xSemaphoreGive(shm_mutex);
                    }
                }
                rx_line_idx = 0; // 초기화
            } else {
                if (rx_line_idx < sizeof(rx_line_buf) - 1) {
                    rx_line_buf[rx_line_idx++] = byte;
                } else {
                    rx_line_idx = 0; // 버퍼 오버플로우 방지
                }
            }
        }

        /* [2. 송신 처리] snprintf를 이용한 문자열 생성 및 전송 */
        if (shm_mutex != NULL && xSemaphoreTake(shm_mutex, pdMS_TO_TICKS(10)) == pdTRUE) {
            char tx_str[128];

            // 데이터 포맷팅
            int len = snprintf(tx_str, sizeof(tx_str), "ID:%u,TYP:%u,PWR:%u,PRS:%u,TMP:%u,RPM:%u,WRN:%u\n",RPi_Shared_Data.module_id,
                               (uint32_t)RPi_Shared_Data.module_type,
                               (uint32_t)RPi_Shared_Data.reported_power_w,
                               (uint32_t)RPi_Shared_Data.pressure_value,
                               (uint32_t)RPi_Shared_Data.current_temp_c,
                               (uint8_t)RPi_Shared_Data.current_speed_rpm,
                               (uint8_t)RPi_Shared_Data.warning_flag);

            // 생성된 문자열 전송
            for (int i = 0; i < len; i++) {
                UART3_Send_Byte_IT(tx_str[i]);
            }
            xSemaphoreGive(shm_mutex);
        }

        vTaskDelayUntil(&xLastWakeTime, xFrequency);
    }
}
