// 공유 메모리에서 데이터를 긁어와 송신 패킷을 만드는 함수
void Send_System_Packet(SystemSharedData_t* shared_data) {
    UartCommPacket_t pkt;

    // 1. FreeRTOS 뮤텍스 락 (포트블록 시간은 10ms 수준 권장)
	if (shm_mutex != NULL) {
		if (xSemaphoreTake(shm_mutex, pdMS_TO_TICKS(10)) == pdTRUE) {

			pkt.sof = PACKET_SOF;
			pkt.system_state = (uint8_t)shared_data->system_state;
			pkt.module_type  = (uint8_t)shared_data->module_type;
			pkt.latest_fault  = (uint8_t)shared_data->latest_fault;
			pkt.module_id     = shared_data->module_id;

			// --- [중요 가공 단계] 라즈베리파이 수신 비트 연산 스펙 매핑 ---
			// RPi 스펙: bit 0 = dock, bit 1 = auth
			uint8_t packed_flags = 0;
			if (shared_data->dock_detected) {
				packed_flags |= (1 << 0);
			}
			if (shared_data->auth_result) {
				packed_flags |= (1 << 1);
			}
			pkt.flags = packed_flags;

			pkt.current_speed_rpm = shared_data->current_speed_rpm;
			pkt.reported_power_w  = shared_data->reported_power_w;
			pkt.pressure_value    = shared_data->pressure_value;
			pkt.current_temp_c    = shared_data->current_temp_c;

			// 2. 뮤텍스 언락
			xSemaphoreGive(shm_mutex);
		} else {
			// 뮤텍스를 획득하지 못했을 때의 예외 처리 (자원 점유 실패 시 리턴)
			return;
		}
	}

    // 2. 2의 보수 기반 체크섬 계산 (SOF와 Checksum 필드 자체는 제외)
    uint8_t* base_ptr = (uint8_t*)&pkt;
    uint32_t sum = 0;

    // SOF 다음 바이트(index 1)부터 데이터 끝(Checksum 직전)까지 합산
    for (size_t i = 1; i < sizeof(UartCommPacket_t) - 1; i++) {
        sum += base_ptr[i];
    }

    // 합산 값에 마이너스를 취해 2의 보수 생성
    pkt.checksum = (uint8_t)((~sum) + 1);

    // 3. UART 인터럽트 송신 버퍼로 push
    for (size_t i = 0; i < sizeof(UartCommPacket_t); i++) {
        UART3_Send_Byte_IT((char)base_ptr[i]);
    }
}
